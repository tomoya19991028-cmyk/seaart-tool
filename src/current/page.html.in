<style>
:is(#choiceDialog,#personChoiceDialog,#simpleSelectionDialog,#mainCardChoiceDialog).candidateDialog{height:auto;max-height:90dvh;overflow:hidden}
.candidateDialog>.candidateList{flex:0 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden}
#simpleCandidateCategory{margin:5px 0}#simpleCandidateCategory select{min-height:36px}

/* Targeted mobile layout fixes; candidate data and all scripts are unchanged. */
:is(.candidateDialog,.finishSettingsSheet)>:is(.candidateHeader,.dialogHead)>h2{flex:1 1 0;min-width:0;max-width:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#negativeChoices.negativeCardGrid{grid-template-rows:none;grid-auto-rows:minmax(84px,auto)}
@media(max-width:700px){
#negativeDialog{height:auto;min-height:0;max-height:90dvh}
#negativeDialog>.dialogBody{height:auto;min-height:0;flex:0 1 auto}
#negativeDialog .hint{margin-top:12px;margin-bottom:0}
#personChoiceDialog #adultDisplayTabs:not([hidden]){display:grid;grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:5px;overflow:visible;touch-action:manipulation}
#personChoiceDialog #adultDisplayTabs>button{min-width:0;width:100%;height:36px;min-height:36px;padding:3px 2px;font-size:clamp(.62rem,2.8vw,.75rem);line-height:1.15;white-space:normal;overflow-wrap:anywhere;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
}

/* Shared adult picker spacing and tab appearance. */
#personChoiceDialog.adultDisplayDialog>.candidateHeader{flex-wrap:nowrap;margin-bottom:0;padding-bottom:8px;gap:4px}
#personChoiceDialog #adultDisplayTabs:not([hidden]){margin:0 0 8px;gap:5px}
#personChoiceDialog #adultDisplayTabs>button{border-radius:8px;border:1px solid var(--border);background:#222e3e;color:var(--text);font-weight:700}
#personChoiceDialog #adultDisplayTabs>button.active{background:#5652b6;border-color:var(--border);color:#fff}
#personChoiceDialog #adultDisplayTabs[data-feature="bodyFeatures"]:not([hidden]){display:flex;max-width:100%;overflow-x:auto;overflow-y:hidden;flex-shrink:0;touch-action:pan-x}
#personChoiceDialog #adultDisplayTabs[data-feature="bodyFeatures"]>button{flex:0 0 auto;width:auto;min-width:80px;height:44px;min-height:44px;padding:8px;white-space:nowrap;overflow-wrap:normal}
#personChoiceDialog #adultDisplayTabs[data-feature="damage"]:not([hidden]){display:flex;max-width:100%;overflow-x:auto;overflow-y:hidden;flex-shrink:0;touch-action:pan-x}
#personChoiceDialog #adultDisplayTabs[data-feature="damage"]>button{flex:0 0 auto;width:auto;min-width:80px;height:44px;min-height:44px;padding:8px;white-space:nowrap;overflow-wrap:normal}
#simpleSelectionDialog[data-key="effect"] #simpleClassificationTabs{max-width:100%;overflow-x:auto;overflow-y:hidden;touch-action:pan-x}
#simpleSelectionDialog[data-key="effect"] #simpleClassificationTabs>button{flex:0 0 auto;width:auto;min-width:64px;white-space:nowrap;overflow-wrap:normal}
</style><style id="simpleMangaHostStyle">body[data-simple-manga-open="true"]> :not(#simpleMangaTool):not(script):not(style){display:none!important}#simpleMangaTool{position:fixed;inset:0;z-index:1000;overflow:auto;background:#0c1421;overscroll-behavior:contain}#simpleMangaTool[hidden]{display:none!important}</style><section id="simpleMangaTool" hidden aria-label="簡易漫画専用"></section><script id="simpleMangaIntegration">@@SEAART_SCRIPT_06@@</script><script id="actorFormStorageFoundation">@@SEAART_SCRIPT_07@@</script><script id="creatureAdultQualificationFoundation">@@SEAART_SCRIPT_08@@</script><script id="creatureAdultPersistenceFoundation">@@SEAART_SCRIPT_09@@</script><script id="creatureAdultEditorFoundation">@@SEAART_SCRIPT_10@@</script><script id="commonResultAccessFoundation">@@SEAART_SCRIPT_11@@</script><script id="creatureMotifIndependentPerson">@@SEAART_SCRIPT_12@@</script><script>@@SEAART_SCRIPT_13@@</script>
