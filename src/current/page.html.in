.positionCard{display:flex;flex-direction:column;gap:4px}.positionHead{display:flex;align-items:center;justify-content:space-between;gap:3px;font-size:.73rem;font-weight:700}.positionAuto{padding:3px 7px;min-height:25px;font-size:.68rem}.positionCross{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(27px,1fr));gap:3px;flex:1;min-height:0}.positionCross button{padding:2px;min-height:0;font-size:.7rem}.positionCross button[data-position="back"]{grid-column:2;grid-row:1}.positionCross button[data-position="left"]{grid-column:1;grid-row:2}.positionCross button[data-position="center"]{grid-column:2;grid-row:2}.positionCross button[data-position="right"]{grid-column:3;grid-row:2}.positionCross button[data-position="front"]{grid-column:2;grid-row:3}.positionCross button.active{background:var(--accent-dark);color:var(--accent);border-color:var(--accent)}.combinedEffect{display:grid!important;grid-template-rows:repeat(2,minmax(0,1fr));gap:5px}.combinedEffect>.personPicker{height:auto!important;min-height:0}.combinedEffect .personLaunch{min-height:0;padding:5px 8px;font-size:.72rem}.combinedEffect .chips{padding:0 4px 3px;max-height:22px;overflow:hidden}.menuSheet{margin:auto 0 0!important;width:100%;max-width:none!important;border-radius:22px 22px 0 0!important;max-height:75dvh}.menuButton,.wideExtra{display:block;width:100%;margin:12px 0;text-align:left}.wideExtra{text-align:center}.tagList{display:flex;flex-wrap:wrap;gap:7px;padding:14px 0}.tagList span{padding:7px 10px;border:1px solid var(--border,#405169);border-radius:10px;overflow-wrap:anywhere}.weightList{display:grid;gap:10px}.weightRow{padding:10px;border:1px solid #405169;border-radius:12px;min-width:0}.weightRow strong{display:block;overflow-wrap:anywhere}.weightRow input{width:100%}.weightRow .segments{display:grid;grid-template-columns:50px 1fr 50px;align-items:center;text-align:center}.positionDpad{display:grid!important;grid-template-columns:repeat(3,1fr)!important