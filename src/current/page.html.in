<style id="poseAtomicV39Style">
.paTabs{display:flex;gap:8px;margin:8px 0}.paTabs button{flex:1;min-height:36px}.paTabs .active{background:var(--accent-dark);color:var(--accent)}
.paActionGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin:6px 0 14px}.paAdd{min-height:42px;text-align:left;white-space:normal;overflow-wrap:anywhere}
.paGroup{font-size:.85rem;color:var(--muted);margin:14px 0 5px}.paSelected{display:flex;align-items:center;gap:5px;margin:6px 0}.paSelected .paEdit{flex:1;min-width:0;text-align:left;white-space:normal;overflow-wrap:anywhere}
.paSelected button{min-height:36px}.paFields{display:grid;gap:12px;padding:6px 0 14px}.paFields label{display:grid;gap:5px;font-size:.88rem}.paFields select,.paFields input{width:100%;min-height:40px;box-sizing:border-box}.paFields select{min-width:0;max-width:100%}
.paTargetKinds{display:flex;flex-wrap:wrap;gap:6px}.paTargetKinds button{min-height:36px;flex:1 1 42%}.paTargetKinds .active{color:var(--accent);background:var(--accent-dark)}
.paNotice{font-size:.8rem;line-height:1.6;color:var(--muted);white-space:normal}.paPreview{padding:10px;border:1px solid var(--border);border-radius:10px;line-height:1.6;overflow-wrap:anywhere}.paWarning{color:#f2cf87}
.paTools{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}.paTools button{min-height:34px}.paLegacy{border-top:1px solid var(--border);margin-top:14px;padding-top:10px}
.personPicker[data-atomic-pose] .personLaunch>strong,.personPicker[data-atomic-pose] .personLaunch>small{flex-shrink:0;line-height:1.5}.personPicker[data-atomic-pose] .personSelectedName{white-space:normal;overflow-wrap:anywhere}.personPicker[data-atomic-pose] .chips:empty{display:none}
#personChoiceDialog[data-pose-atomic] #personChoiceChoices{min-height:0;overflow-y:auto;overflow-x:hidden}#personChoiceDialog[data-pose-atomic] [data-subject-control]{display:none!important}
</style>
<script id="poseAtomicV39Script">@@SEAART_SCRIPT_33@@</script>

<style id="uiRefinementV40Style">
#personChoiceDialog .paTargetKinds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
#personChoiceDialog .paTargetKinds[data-count="3"]{grid-template-columns:repeat(3,minmax(0,1fr))}
#personChoiceDialog .paTargetKinds button{min-width:0;min-height:38px;padding:7px 3px;font-size:clamp(10.5px,2.95vw,13px);white-space:nowrap;line-height:1.35}
#simpleSelectionDialog[data-key="effect"] #simpleClassificationTabs{display:grid;grid-template-columns:minmax(0,1.3fr) repeat(4,minmax(0,1fr));width:100%;max-width:100%;box-sizing:border-box;gap:5px;overflow:visible;align-self:stretch;margin-inline:0}
#simpleSelectionDialog[data-key="effect"] #simpleClassificationTabs button{flex:initial;min-width:0;width:100%;min-height:34px;height:34px;padding:5px 2px;font-size:clamp(10.5px,2.85vw,13px);white-space:nowrap;box-sizing:border-box;line-height:1.4}
.gazeTargetEditor{margin-top:14px;padding:12px 0 2px;border-top:1px solid var(--border)}.gazeTargetEditor label{display:grid;gap:7px}.gazeTargetEditor select{width:100%;min-width:0;min-height:42px}.gazeTargetEditor .hint{line-height:1.6}
.paLegacyColor{font-size:.8rem;color:var(--muted);line-height:1.5}.paLegacyColor summary{cursor:pointer}.paLegacyColor button{min-height:36px}
.skinPaletteGroups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:6px 0 12px}.skinPaletteGroups button{min-width:0;min-height:36px;font-size:.75rem;padding:7px 3px;white-space:nowrap}.skinPaletteGroups .active{background:var(--accent-dark);color:var(--accent)}
.skinPaletteGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:8px 0 14px}.skinPaletteCell{position:relative;min-width:0;padding:0;border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--panel)}
.skinPalettePick{display:flex;flex-direction:column;align-items:stretch;gap:6px;min-height:94px;width:100%;border:0!important;background:transparent!important;padding:6px!important;box-sizing:border-box;color:var(--text);text-align:left}
.skinPaletteSample{display:block;width:100%;height:39px;min-height:39px;border:1px solid #ffffff25;border-radius:7px;box-sizing:border-box}.skinPaletteName{font-size:.75rem;line-height:1.45;overflow-wrap:anywhere;padding-right:12px}.skinPaletteCell.selected{outline:2px solid var(--accent);outline-offset:-2px}.skinPaletteSelected{position:absolute;top:8px;left:8px;background:#152028;color:#fff;border-radius:20px;padding:1px 6px;font-size:.68rem;pointer-events:none}
.skinPaletteStar{position:absolute;right:3px;bottom:3px;min-height:27px;min-width:25px;padding:2px!important;font-size:1rem;color:#ebd699}.skinPaletteSection{margin:12px 0 5px;font-size:.82rem;color:var(--muted)}.skinPaletteHelp{font-size:.78rem;color:var(--muted);line-height:1.6;margin:6px 0 10px}
.skinPaletteSelectedRow{display:flex;align-items:center;gap:6px;margin:7px 0}.skinPaletteSelectedRow .personSelectedOpen{flex:1;min-width:0;text-align:left;white-space:normal}.skinPaletteSelectedRow .itemColorDot{flex-shrink:0}.skinSwatchDot{flex-shrink:0}
</style>
<script id="uiRefinementV40Script">@@SEAART_SCRIPT_34@@</script>

<style id="compactPickerRowsV42Style">
#simpleSelectionDialog[data-key="lighting"] #simpleClassificationTabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;width:100%;max-width:100%;box-sizing:border-box;align-self:stretch;margin-inline:0}
#simpleSelectionDialog[data-key="lighting"] #simpleClassificationTabs>button{width:100%;min-width:0;min-height:34px;height:34px;box-sizing:border-box;padding:5px 2px;white-space:nowrap;font-size:clamp(10px,2.8vw,13px);line-height:1.35}
#colorPaletteModes[data-palette-kind="hair"]{display:grid;grid-template-columns:minmax(0,1fr);gap:5px;width:100%;margin:7px 0;box-sizing:border-box}
#colorPaletteModes[data-palette-kind="hair"] .paletteModeRow{display:grid;grid-template-columns:repeat(var(--mode-columns),minmax(0,1fr));gap:5px;width:100%;min-width:0}
#colorPaletteModes[data-palette-kind="hair"] button{width:100%;min-width:0;min-height:36px;padding:6px 2px;margin:0;box-sizing:border-box;font-size:clamp(9px,2.8vw,12px);line-height:1.35;white-space:normal;overflow-wrap:anywhere}
#personChoiceDialog #personQuickTabs.characterQuickRow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;width:100%;box-sizing:border-box}
#personChoiceDialog #personQuickTabs.characterQuickRow>button[data-quick],#personChoiceDialog #personQuickTabs.characterQuickRow>#personCharacterCandidates{grid-column:auto;grid-row:auto;width:100%;min-width:0;min-height:34px;height:34px;margin:0;padding:5px 3px;box-sizing:border-box;font-size:clamp(10px,2.8vw,12px);white-space:nowrap;line-height:1.35;color:var(--text)}
#personChoiceDialog #personQuickTabs.characterQuickRow>button[data-tendency]{grid-column:span 2;min-width:0;min-height:32px;font-size:.73rem;padding:5px 3px}
#personChoiceDialog #personQuickTabs.characterQuickRow>button[hidden]{display:none!important}
#personChoiceDialog #personQuickTabs.characterQuickRow>button.active{color:#fff;background:#5652b6}
#personChoiceDialog #personCharacterCandidateControls[hidden]{display:none!important}
/* Keep cards usable when landscape, text zoom or a keyboard leaves little room. */
body[data-mobile-tab="people"] #workspaceMain{overflow-y:auto;overscroll-behavior:contain}
body[data-mobile-tab="people"] #peopleSection{overflow:visible}
body[data-mobile-tab="people"] #profiles,
body[data-mobile-tab="people"] #adultSceneSection,
body[data-mobile-tab="people"] #creatureSettings:not([hidden]){min-height:12rem}
@media (max-height:500px){
 :is(#choiceDialog,#personChoiceDialog,#simpleSelectionDialog,#mainCardChoiceDialog).candidateDialog{overflow-y:auto}
 :is(#choiceDialog,#personChoiceDialog,#simpleSelectionDialog,#mainCardChoiceDialog).candidateDialog>.candidateList{flex:0 0 auto;min-height:150px;max-height:45dvh}
}
</style>
<script id="compactPickerRowsV42Script">@@SEAART_SCRIPT_35@@</script>

<script id="characterCandidateFilterV43Script">@@SEAART_SCRIPT_36@@</script>

</body></html>
