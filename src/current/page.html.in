#creatureChoices .creatureColorPalette{overflow:visible;grid-template-columns:repeat(4,minmax(0,1fr))}
#creatureChoices .creaturePaletteCell{position:relative;min-width:0}
#creatureChoices .creaturePaletteCell .paletteChoice{width:100%;min-height:82px}
#creatureChoices .creaturePaletteCell .paletteColor{width:100%;height:36px;border-radius:7px;margin:0}
#creatureChoices .creaturePaletteCell .quickStar{position:absolute;top:4px;right:4px;min-width:30px;min-height:30px;padding:2px;border-radius:6px;background:var(--surface)}
#candidateManageGroups{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;margin-bottom:12px}
#candidateManageGroups button{min-width:0;padding:7px 2px;font-size:.75rem;white-space:nowrap}
#candidateManageGroups button.active{background:#5652b6;color:#fff}
#editor{width:min(520px,calc(100vw - 24px));max-height:90dvh;box-sizing:border-box;padding:16px;overflow-y:auto}
#editor .field{min-width:0}#editor input,#editor select{box-sizing:border-box;max-width:100%}
#editColorField[hidden]{display:none}#editDisplayColor{width:100%;height:44px;padding:3px}
#candidateManageDialog{width:min(520px,calc(100vw - 24px));max-height:90dvh}
#candidateManageDialog>.dialogHead{flex:none}#candidateManageDialog>.dialogBody{min-height:0;overflow-y:auto;max-height:70dvh}

.creatureRepresentation{padding:0 10px 10px;display:grid;gap:6px;min-width:0}.creatureRepresentationModes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}.creatureRepresentation button{min-height:44px;padding:6px 3px;min-width:0;font-size:12px}.creatureRepresentation .active{border-color:var(--accent);background:var(--accent);color:#102725}.actorFormDraftRow .quickStar{min-width:44px;width:44px;flex:none}.actorFormDraftRow input[type=number]{max-width:70px;min-width:0}.actorFormTools select{min-width:0;max-width:100%}

/* Weapon instances share the pose editor and stay usable at enlarged text sizes. */
.waEditor{min-width:0;overflow-wrap:anywhere}.waEditor label{display:block;margin:8px 0}.waEditor select,.waEditor input:not([type=checkbox]){box-sizing:border-box;min-width:0;width:100%;min-height:44px;max-width:100%}.waEditor h3{font-size:1rem;margin:12px 0 6px}.waSection{padding:8px 0 14px;border-top:1px solid var(--line,#344354)}.waEditor button,.waTabs button{min-height:44px;white-space:normal;overflow-wrap:anywhere;max-width:100%;height:auto}.waSection>button{margin:4px}.waConflict{border:1px solid #d9a54c;padding:10px;border-radius:8px}.waLegacy{margin-top:12px}.waLegacyRow{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:8px 0}.waLegacyRow>span{flex:1 1 120px}.waTabs{display:flex;gap:6px;padding:8px}.waTabs button{flex:1}.waWeaponRow{display:flex;gap:5px;align-items:center;padding:6px 0}.waWeaponRow>label{flex:1;min-width:0}.waWeaponRow input{margin-right:8px}#unifiedHumanGroupDialog:has(.waEditor){max-height:95dvh}#unifiedHumanGroupDialog>.waEditor{overflow-y:auto}
</style><style>.reviewSummaryRow{width:100%;display:flex;align-items:center;gap:8px;min-height:44px;margin:6px 0;padding:8px 12px;text-align:left}.reviewSummaryRow span:first-child{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.reviewSummaryRow span:last-child{font-size:.76rem;color:var(--muted);white-space:nowrap}.reviewFullDetails{margin:10px 0;border:1px solid var(--border);border-radius:10px;padding:10px}.reviewFullDetails>summary{font-weight:700;cursor:pointer}</style><style>.scenarioImporter{padding:10px;margin:8px 0;border:1px solid #59627a;border-radius:12px}.scenarioImporterRow{display:grid;grid-template-columns:1fr 1fr;gap:8px}.scenarioImporterRow button{grid-column:1/-1}.scenarioImporter select{min-width:0;width:100%}</style><style>#adultBodyPickers{min-height:0;overflow:auto;align-content:start}</style><style>
 #choiceDialog .quickTabs,#personChoiceDialog .quickTabs{gap:5px;margin:5px 0 4px}
 #choiceDialog .quickTabs button,#personChoiceDialog .quickTabs button{
  min-height:32px;padding:3px 2px;font-size:.75rem;line-height:1.15;border-radius:8px
 }
 #characterFilters.characterMode{grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) minmax(0,.85fr);gap:5px;margin:5px 0}
 #characterFilters.characterMode label{min-width:0;font-size:.68rem;white-space:nowrap}
 #characterFilters.characterMode select{min-width:0;max-width:100%;min-height:34px;margin-top:2px;padding:3px 2px;font-size:.72rem}
 #choiceDialogChoices,#personChoiceChoices{max-height:56dvh;margin:6px 0}
 #personChoiceDialog.hasCustom #personChoiceChoices{max-height:41dvh}
 @media(max-width:350px){
  #characterFilters.characterMode{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,.8fr);gap:3px}
  #characterFilters.characterMode select{font-size:.67rem}
 }
</style><style>
 #choiceDialog{position:relative}
 #choiceDialog>.row{gap:5px;margin-bottom:8px}
 #choiceDialogTitle{flex:1;min-width:0;max-width:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 #choiceSortOpen{flex:none;min-height:36px;padding:5px 8px;font-size:.75rem;white-space:nowrap}
 #choiceSortOpen[hidden]{display:none!important}
 #choiceSortMenu{position:absolute;z-index:20;top:48px;right:83px;width:min(190px,calc(100% - 24px));padding:5px;background:#283247;border:1px solid #5c6880;border-radius:10px;box-shadow:0 10px 25px #0009}
 #choiceSortMenu[hidden]{display:none!important}
 #choiceSortMenu button{display:block;width:100%;min-height:38px;text-align:left;padding:6px 9px;font-size:.78rem}
 #choiceSortMenu button[aria-pressed=true]{background:#514fac;color:white}
 #characterFilters.characterMode,#characterFilters:not(.characterMode){display:block;margin:5px 0}
 #characterFilters[hidden]{display:none!important}
 #characterFilters .characterFilterRow{display:flex;align-items:end;gap:5px;min-width:0}
 #characterFilters .characterFilterRow>label{flex:1;min-width:0}
 #characterFilters .characterFilterRow select{width:100%;min-width:0;min-height:36px;max-width:100%;padding:4px 5px;font-size:.78rem}
 #characterGenderWrap{display:flex;gap:4px;flex:none}
 #characterGenderWrap[hidden]{display:none!important}
 #characterGenderWrap button{min-height:36px;min-width:43px;padding:4px 5px;font-size:.72rem;background:#30394f;color:#d9deeb}
 #characterGenderWrap button.active{background:#5652b6;color:white}
 #characterSort[hidden],#characterGender[hidden]{display:none!important}
 @media(max-width:350px){#characterGenderWrap button{min-width:38px;padding:4px 2px}#choiceSortOpen{padding:5px 6px;font-size:.71rem}}
</style><style>
 /* Keep the work selector and both gender controls on one baseline. */
 #characterFilters.characterMode .characterFilterRow{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:6px;align-items:end;width:100%
 }
 #characterFilters.characterMode .characterFilterRow>label{
  display:flex;flex-direction:column;gap:3px;min-width:0;
  line-height:1.1;overflow:hidden
 }
 #characterFilters.characterMode .characterFilterRow select{
  display:block;box-sizing:border-box;width:100%;height:42px;min-height:42px;
  max-height:42px;margin:0;padding:4px 24px 4px 8px;font-size:.76rem
 }
 #characterFilters.characterMode #characterGenderWrap{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;
  align-self:end;min-width:0
 }
 #characterFilters.characterMode #characterGenderWrap[hidden]{display:none!important}
 #characterFilters.characterMode #characterGenderWrap button{
  box-sizing:border-box;width:100%;height:42px;min-height:42px;
  max-height:42px;min-width:0;margin:0;padding:4px 2px;
  font-size:.75rem;line-height:1.1
 }
 @media(max-width:350px){
  #characterFilters.characterMode .characterFilterRow{gap:4px}
  #characterFilters.characterMode #characterGenderWrap{gap:4px}
 }
</style><style>
 #choiceQuickTabs.fiveFilters,#personQuickTabs.fiveFilters{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr) minmax(0,.52fr) minmax(0,.85fr) minmax(0,.85fr);gap:4px
 }
 #choiceQuickTabs.fiveFilters button,#personQuickTabs.fiveFilters button{
  width:100%;min-width:0;min-height:34px;padding:3px 0;font-size:.7rem;
  line-height:1.1;white-space:nowrap;color:#e7eaf5
 }
 #choiceQuickTabs.fiveFilters button[hidden],#personQuickTabs.fiveFilters button[hidden]{display:none!important}
 #choiceQuickTabs.fiveFilters button.active,#personQuickTabs.fiveFilters button.active{color:#fff}
 #characterFilters.characterMode .characterFilterRow{display:block}
 #characterFilters.characterMode .characterFilterRow>label{width:100%}
 #characterFilters.characterMode #characterGenderWrap{display:none!important}
 @media(max-width:350px){
  #choiceQuickTabs.fiveFilters,#personQuickTabs.fiveFilters{gap:3px}
  #choiceQuickTabs.fiveFilters button,#personQuickTabs.fiveFilters button{font-size:.65rem}
 }
</style><style>
 #personChoiceDialog{position:relative}
 #personChoiceDialog>.row{gap:5px;margin-bottom:8px}
 #personChoiceTitle{flex:1;min-width:0;max-width:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 #personSortOpen{flex:none;min-height:36px;padding:5px 8px;font-size:.75rem;white-space:nowrap}
 #personSortOpen[hidden],#personSortMenu[hidden]{display:none!important}
 #personSortMenu{position:absolute;z-index:20;top:48px;right:83px;width:min(190px,calc(100% - 24px));padding:5px;background:#283247;border:1px solid #5c6880;border-radius:10px;box-shadow:0 10px 25px #0009}
 #personSortMenu button{display:block;width:100%;min-height:38px;text-align:left;padding:6px 9px;font-size:.78rem}
 #personSortMenu button[aria-pressed=true]{background:#514fac;color:white}
 #personChoiceFilters{grid-template-columns:minmax(0,1fr)}
 #personChoiceSort[hidden]{display:none!important}
</style><style>
 .colorSummaryCard{display:flex;flex-direction:column}
 .colorCardLaunch{width:100%;height:100%;min-height:0;background:transparent;color:var(--text);text-align:left;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:7px;padding:8px}
 .colorCardLaunch strong{font-size:.95rem}.colorCardLaunch small{font-size:.72rem;color:var(--muted);line-height:1.35}
 .colorCardSwatches{display:flex;gap:5px}.colorCardDot{display:block;width:26px;height:26px;border:1px solid #8994a5;border-radius:7px}
 #colorPaletteDialog{max-height:92dvh;overflow:hidden}
 #colorPaletteDialog[open]{display:flex;flex-direction:column}
 .paletteModes,.paletteSlots{display:flex;gap:5px;flex-wrap:wrap;margin:7px 0;flex:none}
 .paletteModes button{min-height:34px;padding:5px 7px;font-size:.73rem}
 .paletteModes button.active,.paletteSlot.active,.paletteChoice.active{border-color:var(--accent);background:#25524e;color:#fff}
 .paletteSlot{flex:1;min-width:0;min-height:44px;display:flex;flex-direction:column;gap:2px;padding:5px;font-size:.72rem}
 .paletteSlot span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:400}
 .paletteChoices{min-height:0;overflow:auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;padding:6px 1px;align-content:start}
 .paletteChoice{min-width:0;min-height:77px;padding:5px;display:flex;flex-direction:column;align-items:center;gap:4px;background:var(--surface);color:var(--text);border:1px solid var(--border)}
 .paletteColor{width:100%;height:36px;border:1px solid #8994a5;border-radius:7px;flex:none}
 .paletteName{font-size:.65rem;line-height:1.2;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow-wrap:anywhere}
