#profiles .equipmentInner .personPicker,.equipmentInner .personPicker{height:auto;min-height:88px}.equipmentInner{display:grid;gap:9px}.equipmentInner .personPicker .chips{padding:0 8px 9px}.equipmentDetailDialog>.dialogHead,.adultDetailDialog>.dialogHead{flex:none}.equipmentDetailDialog[open],.adultDetailDialog[open]{display:flex;flex-direction:column;max-height:86dvh;overflow:hidden}.equipmentDetailDialog>.dialogBody,.adultDetailDialog>.dialogBody{min-height:0;overflow:auto;overscroll-behavior:contain}
#profiles .skinCardLaunch{padding:10px;gap:7px}#profiles .skinCardLaunch small{font-size:.73rem}#profiles .positionCardLaunch{gap:7px;padding:10px}#profiles .colorSummaryCard>.colorCardLaunch{padding:10px;gap:7px}.positionDialogHeader h2,.skinDialogHeader h2,.dialogHead h2{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dialogHead>button,.positionDialogHeader>button,.skinDialogHeader>button{flex:none;white-space:nowrap}
.adultDashboard{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:9px;flex:1;min-height:0}.adultTile{min-width:0;min-height:0}.adultTile>.personLaunch{width:100%;height:100%;padding:11px}.adultTile>.personLaunch small{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.35;overflow:hidden}.adultConfirmEdit{flex:none;min-height:28px;font-size:.7rem;padding:4px}#adultFields>.field.uiOff{display:none!important}#adultDashboard .adultDetailDialog{width:min(94vw,510px)}#adultDashboard .dialogBody>.scenarioImporter{display:block!important}
.negativeCardGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(84px,1fr));gap:9px}.settingTile{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;text-align:left;gap:6px;min-width:0;min-height:85px;padding:12px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius)}.settingTile strong{font-size:.88rem}.settingTile small,.settingTile span{color:var(--muted);font-size:.73rem;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.negativePresetBar{margin-bottom:10px;padding:5px;border:1px solid var(--border);border-radius:12px}.negativePresetBar button{min-height:37px}.negativeChoice span{min-width:0}.negativeChoice strong{display:block;font-size:.88rem}.negativeChoice small{display:block;font-size:.72rem;font-weight:400;color:var(--muted);margin-top:5px;overflow-wrap:anywhere}#negativeCategoryDialog{width:min(94vw,520px)}#negativeCategoryDialog details>summary{font-size:.85rem;padding:9px 0;cursor:pointer}
.styleBlock{margin:0 0 17px}.styleBlock h3{margin:0 0 8px;font-size:.95rem}.styleButtons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.styleButtons button{min-height:45px;text-align:center;font-size:.84rem}.styleButtons button.active{border-color:var(--accent);color:var(--accent);background:var(--accent-dark)}
#artDialog{max-height:85dvh;padding:0;overflow:hidden}#artDialog[open]{display:flex;flex-direction:column}#artDialog>.dialogHead{flex:none;margin:0;padding:12px 16px;border-bottom:1px solid var(--border)}#artDialog>.dialogBody{min-height:0;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:14px 16px calc(20px + env(safe-area-inset-bottom))}#artChoices .styleButtons button{min-width:0;white-space:normal;overflow-wrap:anywhere;line-height:1.4}#artChoices .artNone{width:100%;min-height:45px;margin:0 0 16px}#artChoices .artNone.active{border-color:var(--accent);color:var(--accent);background:var(--accent-dark)}#artDisplayTools{margin:0 0 12px}#artDisplayTools button{min-height:38px;font-size:.78rem}

.subjectSeparationSettings{flex:none;min-width:0}.subjectSeparationSettings>strong{display:block;font-size:.78rem;margin-bottom:5px}.subjectSeparationSettings .segments{margin:0;gap:6px}.subjectSeparationSettings button{flex:1;min-width:0;min-height:38px;padding:6px 3px;font-size:.75rem}.subjectSeparationSettings .hint{font-size:.66rem;line-height:1.35;margin:5px 0 0}.subjectSeparationSettings button.active{border-color:var(--accent);color:var(--accent);background:var(--accent-dark)}
#styleDialog{padding:0;overflow:hidden}#styleDialog[open]{display:flex;flex-direction:column}#styleDialog>.dialogHead{flex:none;margin:0;padding:12px 16px;border-bottom:1px solid var(--border)}#styleDialog>.dialogBody{flex:0 1 auto;min-height:0;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:14px 16px calc(20px + env(safe-area-inset-bottom))}
.dashboardSection{margin:0 0 14px;padding:10px;border:1px solid var(--border);border-radius:12px}.dashboardSection h3,.dashboardSection>summary{font-size:.96rem;margin:0;padding:7px 3px}.dashboardSection>summary{cursor:pointer}.dashboardGroup h4{font-size:.8rem;color:var(--muted);margin:13px 3px 4px}.dashboardRow{border-top:1px solid var(--border);padding:6px 0}.dashboardLink{width:100%;display:flex;flex-direction:column;gap:5px;align-items:flex-start;background:transparent;color:var(--text);padding:8px 4px;text-align:left;min-height:52px}.dashboardLink strong{font-size:.84rem}.dashboardLink span{font-size:.78rem;color:var(--muted);font-weight:400;overflow-wrap:anywhere}.dashboardChips{display:flex;flex-wrap:wrap;gap:5px}.dashboardChips .chip{max-width:100%;min-height:30px;font-size:.7rem}
#resultTagList{min-height:0;max-height:none;flex:1;overflow-y:auto;align-content:flex-start;overscroll-behavior:contain;padding:7px 0}#resultTagList[hidden]{display:none!important}#resultTagList .resultTag{white-space:normal;overflow-wrap:anywhere;max-width:100%;min-height:35px;padding:7px 10px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:9px;font-size:.78rem;text-align:left;font-weight:400}#resultBack{flex:none}dialog .dialogBody,dialog{overscroll-behavior:contain}body:has(dialog[open]) #workspaceMain{overflow:hidden}
@media(max-height:650px){#profiles .profileGrid,#profiles .detailGrid{overflow-y:auto;grid-auto-rows:minmax(76px,1fr)}#profiles .detailGrid.clothingGrid{grid-template-rows:repeat(3,minmax(76px,1fr))}.adultDashboard{grid-template-rows:repeat(3,minmax(76px,1fr));overflow-y:auto}}

#weightControls .weightGroup{display:grid;gap:10px;min-width:0}#weightControls .weightGroup h3{font-size:.95rem;overflow-wrap:anywhere;margin:4px 0}#weightControls .weightRow{display:grid;gap:8px}#weightControls .weightRow .segments button{min-height:44px}#weightsDialog .dialogBody{overflow-y:auto;overscroll-behavior:contain;min-height:0}#weightsDialog .detailBox{flex-shrink:0}
.gazeDialog .gazeBody{display:block;overflow-y:auto;overscroll-behavior:contain}.gazeBody section+section{margin-top:20px}.gazeBody h3{margin:0 0 10px;font-size:1rem}.directionTiles{display:grid;gap:8px;grid-template-columns:repeat(2,minmax(0,1fr))}.faceTiles{grid-template-columns:repeat(3,minmax(0,1fr))}.directionTile{min-width:0;min-height:48px;padding:10px 5px;font-size:.9rem;white-space:normal;line-height:1.4}.directionTile.active{background:var(--accent-dark);color:var(--accent);border:1px solid var(--accent)}.directionTile:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(max-width:350px){.faceTiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
.summaryChipName .chipAttribute{display:block;font-size:.68rem;line-height:1.25;font-weight:400;color:var(--muted)}.inheritedChip{border:1px dashed #65847f}.summaryChips{max-width:100%;flex-wrap:wrap}.summaryChip{min-width:0;max-width:100%}.summaryChipName{white-space:normal;overflow-wrap:anywhere;text-align:left}.environmentTabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;margin:6px 0}.environmentTabs[hidden]{display:none}.environmentTabs button{min-height:38px;padding:7px 5px;font-size:.78rem}.environmentTabs .active{background:var(--accent-dark);color:var(--accent)}.dashboardChips .weightedChip{max-width:100%}.dashboardChips .chipName{white-space:normal;overflow-wrap:anywhere}</style>
<style>
#weightsDialog{box-sizing:border-box;width:min(640px,calc(100vw - 16px));max-width:calc(100vw - 16px);height:auto;max-height:90dvh;margin:auto auto 0!important;inset:auto 0 0;padding:0;overflow:hidden}
#weightsDialog[open]{display:flex;flex-direction:column}
#weightsDialog>.dialogHead{flex:none;margin:0;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg);z-index:1}
#weightsDialog>.dialogHead h2{margin:0}#weightsDialog>.dialogHead button{min-height:44px}
#weightsDialog>.dialogBody{flex:0 1 auto;min-height:0;max-height:none;height:auto;display:block;padding:14px 16px calc(20px + env(safe-area-inset-bottom));overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch}
#weightsDialog .detailBox,#weightsDialog #weightControls,#weightsDialog .weightGroup,#weightsDialog .weightList{height:auto;max-height:none;overflow:visible}
#weightsDialog .weightRow{min-width:0;touch-action:pan-y}#weightsDialog .weightRow strong{overflow-wrap:anywhere}
#weightsDialog input[type=range]{touch-action:pan-y}
#identityDialog,#creatureIdentityDialog{box-sizing:border-box;width:min(560px,calc(100vw - 20px));max-width:calc(100vw - 20px);max-height:calc(100dvh - 24px);padding:0;overflow:hidden;margin:auto!important}
#identityDialog[open],#creatureIdentityDialog[open]{display:flex;flex-direction:column}#identityDialog>.dialogHead,#creatureIdentityDialog>.dialogHead{flex:none;padding:12px 16px;margin:0;border-bottom:1px solid var(--border)}#identityDialog>.dialogHead button,#creatureIdentityDialog>.dialogHead button{min-height:44px}#identityDialog>.dialogBody,#creatureIdentityDialog>.dialogBody{min-height:0;overflow-y:auto;padding:12px 16px;overscroll-behavior:contain}
.identityPerson{display:grid;gap:10px;padding:14px 0;border-bottom:1px solid var(--border)}.identityPerson:last-child{border-bottom:0}.identityPerson h3{margin:0;font-size:1rem;overflow-wrap:anywhere}.identityPerson button{min-height:44px;width:100%}.identityPerson label{margin:0}.identityPerson input{max-width:100%;box-sizing:border-box}
#personLegacyCandidates[hidden]{display:none}.clothingRoleHint{margin:5px 0 9px;font-size:.78rem;color:var(--muted);line-height:1.5}
#profiles .personPicker>.chips .personSelectedItem{max-width:100%}#profiles .personSelectedName{white-space:normal;overflow-wrap:anywhere}#profiles .personSelectedOpen{min-width:0;flex-wrap:wrap}#profiles .personSelectedRemove{flex-shrink:0}
</style>
<style>
#personChoiceDialog.adultDisplayDialog{height:calc(100dvh - 16px);max-height:calc(100dvh - 16px);width:min(640px,calc(100vw - 16px));margin:auto!important;inset:0;padding:12px;overflow:hidden;border-radius:20px}
#personChoiceDialog.adultDisplayDialog[open]{display:flex;flex-direction:column;gap:6px}
#personChoiceDialog.adultDisplayDialog> :not(#personChoiceChoices):not(#personQuickTabs){flex:none;margin-top:0;margin-bottom:0}
#personChoiceDialog.adultDisplayDialog>#personQuickTabs{flex:none}
#personChoiceDialog.adultDisplayDialog>.row{flex-wrap:wrap;gap:6px}
#personChoiceDialog.adultDisplayDialog>.row h2{flex:1;min-width:0;max-width:none;font-size:.88rem;overflow-wrap:anywhere}

#personChoiceDialog.adultDisplayDialog #personChoiceChoices{flex:1;min-height:0;max-height:none;overflow-x:hidden;overflow-y:auto;margin:0;touch-action:pan-y;-webkit-overflow-scrolling:touch}
#personChoiceDialog.adultDisplayDialog #personChoiceSearch{position:static;min-height:42px}
#personChoiceDialog.adultDisplayDialog .modalOption{gap:7px;min-height:52px}
#personChoiceDialog.adultDisplayDialog .modalOption span{overflow-wrap:anywhere}
#personChoiceDialog.adultDisplayDialog #personChoiceChoices>div:not(.scenarioImporter){max-height:none;overflow:visible}
#personChoiceDialog.adultDisplayDialog .adultDisplayTabs{display:flex;gap:7px}
#personChoiceDialog.adultDisplayDialog .adultDisplayTabs[hidden]{display:none}
#personChoiceDialog.adultDisplayDialog .adultDisplayTabs button{flex:1;min-width:0;min-height:44px;padding:8px;font-size:.82rem}
#personChoiceDialog.adultDisplayDialog .adultDisplayTabs button.active{background:var(--accent-dark);border-color:var(--accent);color:var(--accent)}
#personChoiceDialog.adultDisplayDialog #personChoiceChoices textarea{width:100%;min-height:68px}
</style><style>
#personChoiceDialog .adultAuditLegacyControl[hidden]{display:none!important}
</style><style id="unifiedCardTagsStyle">
/* Targeted card previews use the existing personPicker / personSelectedItem styles. */
:is(#profiles,#adultDashboard) .unifiedTagCard{padding:0!important;gap:0;display:flex;flex-direction:column;overflow:hidden;min-width:0;min-height:0}
:is(#profiles,#adultDashboard) .unifiedTagCard>.personLaunch{width:100%;height:auto!important;flex:1;min-height:42px;padding:10px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:7px;text-align:left}
:is(#profiles,#adultDashboard) .unifiedTagCard>.personLaunch strong{font-size:.86rem;line-height:1.3}
:is(#profiles,#adultDashboard) .unifiedTagCard>.personLaunch small{display:block;font-size:.73rem;color:var(--muted);font-weight:400;white-space:nowrap;line-height:normal;max-height:none}
:is(#profiles,#adultDashboard) .unifiedTagCard>.chips{display:flex;flex:0 1 auto;flex-wrap:wrap;align-items:stretch;gap:4px;width:100%;max-width:100%;min-height:0;max-height:none;padding:0 7px 7px;margin:0;overflow-x:hidden;overflow-y:auto;scrollbar-width:thin}
:is(#profiles,#adultDashboard) .unifiedTagCard>.chips:empty{display:none}
:is(#profiles,#adultDashboard) .unifiedTagCard>.chips .personSelectedItem{max-width:100%;flex-shrink:0}
:is(#profiles,#adultDashboard) .unifiedTagCard>.chips .personSelectedName{white-space:normal;overflow-wrap:anywhere}
#pickers .cardSelection .itemColorDot,:is(#profiles,#adultDashboard) :is(.personSelectedItem,.summaryChip)>.itemColorDot{width:11px;height:11px;flex:0 0 11px;align-self:center;margin:0 3px;border-width:1px}
</style>
<style>
/* Compact manual character-preset controls; existing person cards and dialogs retain their styles. */
.characterPresetBar{display:flex;align-items:center;gap:6px;flex:none;min-width:0}
.characterPresetInfo{flex:1;min-width:0}.characterPresetInfo strong{display:block;font-size:.72rem;font-weight:600}.characterPresetInfo small{display:block;color:var(--muted);font-size:.62rem;line-height:1.35;overflow-wrap:anywhere}
.characterPresetBar button,.characterPresetBar select{flex:none;width:auto;min-width:0;min-height:34px;height:34px;padding:4px 8px;font-size:.69rem;white-space:nowrap}
.characterPresetBar select{max-width:32%;padding-right:20px}.characterPresetBar[hidden]{display:none}

/* Form controls share existing buttons and candidate rows; only the form list scrolls. */
.actorFormControls{min-width:0;max-width:100%;flex-wrap:wrap}.actorFormControls.actorFormMulti .characterPresetInfo{flex-basis:100%}
.actorFormControls button,.actorFormControls select{min-height:44px;height:44px;box-sizing:border-box}.actorFormControls select,.actorFormControls .actorFormLaunch{flex:1;min-width:0;width:0;max-width:none;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}
#creaturePresetControls>.actorFormLaunch{flex:1;min-width:44px}
.actorFormControls .actorFormLaunch[hidden],.actorFormControls select[hidden],.actorFormControls button[hidden]{display:none}
.actorFormControls .actorFormStatus{flex-basis:100%;color:var(--muted);font-size:.65rem;overflow-wrap:anywhere}.actorFormControls small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.actorFormControls small[hidden]{display:none}
.actorFormDialog{width:min(540px,calc(100vw - 20px));max-width:calc(100vw - 20px);height:min(620px,90dvh);max-height:90dvh;padding:0;overflow:hidden;box-sizing:border-box}.actorFormDialog[open]{display:flex;flex-direction:column}.actorFormDialog>.dialogHead{flex:none;padding:12px 14px}.actorFormDialog .dialogHead button{min-height:44px}
.actorFormDialog>input{flex:none;width:calc(100% - 28px);margin:0 14px 10px;box-sizing:border-box;min-width:0;min-height:44px}.actorFormDialog>input[hidden]{display:none}.actorFormDialog>.actorFormList{flex:1;min-height:0;max-height:none;padding:0 14px 12px;overflow:auto;overscroll-behavior:contain}.actorFormOption{width:100%;min-width:0;min-height:44px;text-align:left;overflow-wrap:anywhere}.actorFormOption.active{border-color:var(--accent);color:var(--accent)}

/* Owner form management uses the existing modal theme and one scrollable body. */
.actorFormControls .actorFormManage{flex:none;min-width:76px;min-height:44px;padding:4px 8px}.actorFormManagement .actorFormTools{display:flex;flex-wrap:wrap;gap:6px;padding:8px 14px;flex:none}.actorFormManagement .actorFormTools button{flex:1;min-width:100px;min-height:44px}.actorFormManagement .actorFormTools select{flex:1;min-width:0;min-height:44px}
.actorFormManagement>input{width:calc(100% - 28px)!important;margin:0 14px 8px}.actorFormManagement .actorFormManageRow{padding:10px 0;border-bottom:1px solid var(--border);min-width:0}.actorFormManageRow strong{display:block;overflow-wrap:anywhere}.actorFormManageRow small{display:block;color:var(--muted);margin:4px 0}.actorFormActions{display:flex;flex-wrap:wrap;gap:6px}.actorFormActions button{flex:1 1 auto;min-width:62px;min-height:44px;padding:6px 8px}.actorFormManagement>.hint{padding:0 14px;flex:none;margin:0;font-size:.72rem}
.actorFormEditorBody .maField{display:block;margin-bottom:10px}.actorFormEditorBody input,.actorFormEditorBody select,.actorFormEditorBody textarea{box-sizing:border-box;width:100%;min-width:0;min-height:44px}.actorFormEditorBody textarea{resize:vertical}.actorFormEditorBody #actorFormAppearanceFields{display:flex;flex-direction:column;gap:6px}.actorFormEditorBody button{min-height:44px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}.actorFormDraftRow{display:flex;align-items:center;gap:6px;min-width:0}.actorFormDraftRow>button{flex:1;min-width:0}.actorFormDraftRow>input{flex:none;width:64px!important;min-height:44px;box-sizing:border-box}.actorFormManagement .actorFormList{overflow-x:hidden}

/* The five production steps share one compact, fixed navigation row. */
#mangaFlowNav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}
#mangaFlowNav button{min-width:0;min-height:36px;padding:7px 2px;font-size:.7rem;white-space:nowrap}
#mangaStory{overflow-y:auto;overscroll-behavior:contain;padding-bottom:8px;gap:10px}
#mangaStory>*{flex:none;min-width:0}
.mangaStoryHeading{display:flex;align-items:center;justify-content:space-between;gap:8px}
.mangaStoryHeading h3{font-size:.9rem;margin:0}
.mangaStorySettings{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.mangaStorySettings .field{min-width:0;margin:0}
.mangaStorySettings label{font-size:.76rem;margin-bottom:5px}
.mangaStorySettings select{min-width:0;width:100%}
#mangaStory .small{margin:0;font-size:.73rem;line-height:1.5;overflow-wrap:anywhere}
#mangaStoryPreview{border-top:1px solid var(--border);padding-top:10px}
#mangaStoryPreview h4{font-size:.84rem;margin:0 0 6px}
#mangaStorySteps{margin:0 0 10px;padding-left:28px}
#mangaStorySteps li{padding:6px 2px;border-bottom:1px solid var(--border);font-size:.8rem}
#mangaStorySteps li .small{display:block;margin-top:3px}
.mangaStoryActions{display:flex;gap:8px;flex-wrap:wrap}
.mangaStoryActions button{flex:1;min-height:38px;padding:8px;font-size:.78rem}
.mangaStoryActions [hidden]{display:none}
.mangaCard .panelStoryRole{font-size:.67rem;color:var(--accent);line-height:1.3}
/* Only the panel editor uses these five display groups. */
#mangaEditDialog{height:auto;min-height:0;max-height:90vh;max-height:90dvh;overflow:hidden;padding:0;width:calc(100% - 20px);max-width:620px;inset:auto 0 0;margin:auto auto 0}
#mangaEditDialog[open]{display:flex;flex-direction:column}
#mangaEditDialog>.dialogHead{flex:none;margin:0;padding:12px 14px 8px;gap:8px}
#mangaEditDialog>.dialogHead h2{flex:1;max-width:none;margin:0;font-size:.95rem}
#mangaEditDialog>.dialogHead button{min-height:37px;height:37px;padding:6px 11px}
#mangaEditTabs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));flex:none;gap:5px;padding:0 14px 10px;border-bottom:1px solid var(--border)}
#mangaEditTabs button{min-width:0;min-height:34px;padding:5px 2px;font-size:.72rem;line-height:1.3;white-space:nowrap;display:flex;align-items:center;justify-content:center;gap:3px;border-radius:9px}
#mangaEditTabs button.active{background:var(--accent);color:#072a24;border-color:var(--accent)}
.mangaEditDot{width:4px;height:4px;border-radius:50%;background:currentColor;flex:none}
#mangaEditDialog>.dialogBody{flex:0 1 auto;min-height:0;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;padding:12px 14px}
#mangaEditDialog .mangaEditSection[hidden]{display:none!important}
#mangaEditDialog .mangaEditSection>.field{margin:0 0 12px}
#mangaEditDialog .mangaEditSection>.field:last-child{margin-bottom:0}
#mangaEditDialog .mangaEditSection label{font-size:.8rem}
#mangaEditDialog .mangaEditSection textarea{min-height:120px;max-width:100%;font-size:.85rem}
#mangaEditDialog .mangaEditNav{flex:none;padding:9px 14px max(9px,env(safe-area-inset-bottom))}
.mangaPersonEditor{border:1px solid var(--border);background:var(--surface);border-radius:10px;margin-bottom:8px;min-width:0;overflow:hidden}
.mangaPersonEditor>summary{display:list-item!important;list-style-position:inside;cursor:pointer;padding:11px;font-size:.8rem;min-height:48px}
.mangaPersonTitle{overflow-wrap:anywhere;font-weight:700}
.mangaPersonSummary{display:block;color:var(--muted);font-size:.7rem;margin:4px 0 0 16px}
#mangaEditDialog .mangaPersonEditor>.mangaPerson{border-top:1px solid var(--border);margin:0;padding:10px}
#mangaEditDialog .mangaPersonFields{min-width:0}
#mangaEditDialog .mangaPersonFields>.field{min-width:0;margin:0}
#mangaEditDialog .mangaPersonFields select{font-size:.8rem}
#mangaEditDialog .mangaCheck{margin:0 0 12px}
.mangaEditorStoryNote{font-size:.72rem;margin:9px 0 0}
#mangaCreatures{font-size:.73rem;margin:4px 0;color:var(--muted)}
#mangaCreatures[hidden]{display:none}
.mangaSubjectHeading{font-size:.82rem;margin:0 0 8px}
.mangaCreature .mangaPersonFields>.field:last-child{grid-column:auto}

/* Result presentation only; existing prompt textareas remain the data source. */
#mangaOutput{overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}
#mangaResults.mangaResultsFlow{min-width:0;margin:0}
#mangaResults .mangaResultGuide{margin-bottom:10px}
.mangaWholeResult{padding:12px;border:1px solid #366a63;border-radius:var(--radius);background:var(--surface)}
.mangaResultHeading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.mangaResultHeading h3{min-width:0;font-size:.96rem}
.mangaResultHeading button{flex:none;min-height:37px;padding:6px 9px;font-size:.74rem}
.mangaResultCopyActions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
.mangaResultCopyActions button{min-width:0;min-height:42px;padding:8px 4px;font-size:.78rem;overflow-wrap:anywhere}
#mangaPageResultEmpty{margin-top:9px}
.mangaPromptDetails{margin-top:9px}
#mangaResults .mangaPromptDetails>summary{display:list-item!important;list-style-position:inside;cursor:pointer;padding:9px 0;font-size:.79rem;color:var(--muted)}
#mangaResults .mangaPromptDetails>.field{margin:8px 0 0}
#mangaResults .mangaPromptDetails textarea{min-height:120px;height:170px;font-size:.8rem}
#mangaResults .mangaPromptDetails #mangaNegative{height:130px}
.mangaPanelResults{margin-top:17px}
.mangaPanelResults>h3{font-size:.94rem;margin-bottom:5px}
#mangaIndividualEmpty{margin-top:10px}
#mangaResults .mangaIndividual{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;margin-top:8px;padding:10px;border:1px solid var(--border);border-radius:11px;background:var(--surface);min-width:0}
.mangaIndividualHeading{min-width:0}
#mangaResults .mangaIndividualHeading label{margin:0 0 3px;color:var(--text);font-weight:700;font-size:.82rem}
.mangaIndividualSummary{display:block;font-size:.7rem;line-height:1.45;color:var(--muted);overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.mangaIndividualActions{display:flex;gap:5px;flex:none}
.mangaIndividualActions button{min-height:38px;padding:7px 8px;font-size:.75rem}
#mangaResults .mangaIndividual textarea{grid-column:1/-1;min-width:0;min-height:150px;height:180px;font-size:.8rem}
#mangaResultCompose{width:100%;margin:12px 0 4px;min-height:42px}
#mangaStatus{font-size:.73rem;line-height:1.5;margin-top:10px;overflow-wrap:anywhere}

/* Presentation only: both preset systems keep their existing data and handlers. */
.mangaStoryModeSwitch{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
.mangaStoryModeSwitch button{min-width:0;min-height:34px;padding:6px 8px;font-size:.78rem;border-radius:9px}
.mangaStoryModeSwitch button.active{background:#5652b6;color:#fff}
#mangaStoryFlow:not([hidden]),#mangaStoryScene:not([hidden]){display:flex;flex-direction:column;gap:10px}
#mangaStoryFlow[hidden],#mangaStoryScene[hidden]{display:none}
#mangaStoryScene #mangaPagePresetChoices{grid-template-columns:repeat(2,minmax(0,1fr));flex:none;overflow:visible}
#mangaStoryScene #applyMangaPagePreset{width:100%;margin:0;min-height:44px}
#mangaStoryScene [hidden]{display:none}
.mangaSceneDetails{border-top:1px solid var(--border);padding-top:8px}
.mangaSceneDetails>summary{cursor:pointer;min-height:44px;padding:12px 2px;display:list-item;list-style-position:inside;font-size:.82rem}
.mangaSceneDetails[open]>summary{margin-bottom:6px}
.mangaSceneDetails #normalSceneOpen{width:100%;min-height:44px;margin-top:8px;font-size:.8rem}

/* Keep the original person DOM and all its layout selectors in place. */
.mobileSections [data-mobile-tab=people]{font-size:clamp(.61rem,2.65vw,.8rem);padding-left:2px;padding-right:2px;white-space:nowrap}
#characterKindSwitch{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;flex:none}
#characterKindSwitch button{min-height:34px;min-width:0;padding:6px;font-size:.8rem;border-radius:9px}
#characterKindSwitch button.active{background:#5652b6;color:#fff}
#peopleSection[data-character-kind=creature]>:not(.screenHead):not(#characterKindSwitch):not(#creatureSettings){display:none!important}
#creatureRelationsOpen{display:none}
#peopleSection[data-character-kind=creature]>.screenHead #openRelations{display:none}
#peopleSection[data-character-kind=creature]>.screenHead #creatureRelationsOpen{display:inline-block}
#creatureSettings:not([hidden]){display:flex;flex:1;min-height:0;flex-direction:column;gap:9px}
#creatureSettings[hidden]{display:none}
.personBar,.creatureBar{display:flex;align-items:center;gap:6px;flex:none;min-width:0}
.personBar select,.creatureBar select{flex:1 1 0;width:0;min-width:0;height:44px;min-height:44px;padding:8px 10px;font-size:.85rem;line-height:1.2;border-radius:11px;text-overflow:ellipsis}
.personBar button,.creatureBar button{display:inline-flex;align-items:center;justify-content:center;flex:none;height:44px;min-height:44px;padding:8px 6px;font-size:.73rem;line-height:1.2;border-radius:11px;white-space:nowrap}
#personIdentity,#creatureIdentity{width:48px}
#addOriginal,#addCreature{width:64px}
#creatureGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:8px;min-height:0;flex:1}
#creatureGrid .creatureCard{min-width:0;min-height:0;overflow:hidden;display:flex;flex-direction:column;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}
#creatureGrid .creatureCard.hasSelection{background:#203d38;border-color:#598b81}
#creatureGrid .personLaunch{min-width:0;flex:1;min-height:0;padding:10px;font-size:.82rem;white-space:normal;overflow-wrap:anywhere}
#creatureGrid .chips{margin:0;padding:0 7px 7px;overflow-y:auto;max-height:55%;min-height:0}
#creatureGrid .chips:empty{display:none}
#creatureDialog{width:calc(100% - 20px);max-width:640px;height:auto;max-height:90vh;max-height:90dvh;padding:0;overflow:hidden}
#creatureDialog>.dialogHead{display:flex;gap:8px;flex:none;align-items:center;padding:12px 14px}
#creatureDialog h2{flex:1;min-width:0;font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#creatureDialog .dialogHead button{flex:none;min-height:36px;padding:6px 10px;font-size:.78rem}
#creatureFieldTabs{padding:0 14px 8px;gap:7px;flex:none}
#creatureFieldTabs[hidden]{display:none}
#creatureFieldTabs button{flex:1;min-width:0;min-height:34px;padding:6px;font-size:.8rem}
#creatureFieldTabs button.active{background:#5652b6;color:#fff}
#creatureDialog>.dialogBody{min-height:0;flex:0 1 auto;overflow-x:hidden;overflow-y:auto;padding:0 14px calc(12px + env(safe-area-inset-bottom))}
#creatureDialog label:not(.creatureOption){font-size:.76rem}
#creatureSearch{width:100%;min-width:0;min-height:40px;margin-bottom:8px}
#creaturePicked{margin:8px 0;gap:6px}
#creaturePicked .personSelectedName{padding:4px 6px}
#creatureCandidateCount{font-size:.74rem;margin:6px 0;color:var(--muted)}
.creatureOption{display:flex;align-items:center;gap:10px;min-height:44px;padding:10px 2px;border-top:1px solid var(--border);font-size:.88rem;margin:0}
.creatureOption input{flex:none;width:22px;height:22px;margin:0;accent-color:var(--accent)}
@media(max-height:680px){#creatureGrid{gap:6px}#creatureGrid .personLaunch{padding:7px;font-size:.75rem}#characterKindSwitch button{min-height:32px;padding:4px}}

/* Creature choices reuse the same selected rows, favorites, headings and button styles. */
#creatureDialog{box-sizing:border-box;width:min(100%,640px);max-width:100%;inset:auto 0 0;margin:auto auto 0!important;border-radius:23px 23px 0 0}
#creatureDialog[open]{display:flex;flex-direction:column;gap:0}
#creatureDialog>.dialogBody{display:flex;flex-direction:column;min-height:0;overflow:hidden;flex:0 1 auto}
#creatureSearchLabel,#creatureSearch,#creatureQuickTabs,#creatureCandidateCount{flex:none}
#creatureDialog [hidden]{display:none!important}
#creatureQuickTabs{margin:0 0 6px;gap:5px}
#creatureQuickTabs button{min-height:32px;padding:5px 3px;font-size:.76rem}
#creatureFieldTabs{display:flex}
#creatureFieldTabs button{min-height:32px;padding:5px 3px;font-size:.76rem}
#creaturePresetControls>button,#creatureFeatureControls>button{min-height:44px;flex:none}
#creatureChoices{min-height:0;overflow-x:hidden;overflow-y:auto;flex:0 1 auto;border-top:1px solid var(--border);scrollbar-width:thin}
#creatureChoices .modalOption{display:flex;align-items:center;gap:7px;min-width:0;padding:8px 0;margin:0;border-bottom:1px solid var(--border)}
#creatureChoices .creatureOptionPick{display:flex;align-items:center;gap:8px;flex:1;min-width:0;min-height:44px;text-align:left;padding:7px 8px;font-size:.88rem;overflow-wrap:anywhere;background:transparent;border:0}
#creatureChoices .quickStar{min-height:38px;min-width:38px;padding:5px;flex:none;font-size:1.05rem}
#creatureChoices .pickedName{min-width:0;overflow-wrap:anywhere}
.creatureColorDot{width:13px;height:13px;flex:none;border-radius:50%;border:1px solid #aaa}
#creatureChoices .positionDpad{margin:10px auto;grid-template-rows:repeat(3,44px);width:100%}
#creatureChoices .positionDpad button.active,#creatureChoices .creatureDepth button.active{background:var(--accent-dark);color:var(--accent);border-color:var(--accent)}
#creatureChoices .creatureDepth{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin:8px 0}
#creatureChoices .creatureDepth button{min-height:38px;padding:6px;font-size:.82rem;min-width:0}
#creatureChoices>.secondary{min-height:36px;padding:6px 10px;font-size:.78rem;margin-bottom:8px}

/* These controls use the same candidate/card classes as people and backgrounds. */
#creatureDialog{padding:16px 16px calc(18px + env(safe-area-inset-bottom))}
#creatureDialog>.dialogBody{padding:0}
#creatureFieldTabs{padding:0;margin:0 0 8px}
#creatureDialog>.candidateHeader{padding:0;margin:0 0 8px}
#creatureDialog>.candidateHeader h2{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#creatureDialog>.candidateHeader :is(button,.candidateCategoryButton){height:36px;min-height:36px;padding:4px 8px;font-size:.72rem;flex:none}
#creatureDialog .candidateCategoryButton{max-width:85px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#creatureDialog>.candidateCategoryMenu{position:absolute;top:60px;right:16px;z-index:5;max-height:55dvh;overflow-y:auto}
#creatureQuickTabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}
#creatureQuickTabs button{height:32px;min-height:32px;padding:3px 2px;border-radius:8px;font-size:.75rem}
#creatureGrid :is(.personSelectedItem){display:inline-flex;align-items:center;min-height:var(--card-tag-height);padding:0 2px 0 6px;gap:0;border-radius:var(--card-tag-radius);font-size:var(--card-tag-font);line-height:var(--card-tag-line);min-width:0;max-width:100%;box-sizing:border-box}
#creatureGrid .personSelectedOpen{min-height:0;height:auto;padding:0;font-size:var(--card-tag-font);line-height:var(--card-tag-line);min-width:0;display:flex;align-items:center;gap:4px}
#creatureGrid .personSelectedRemove{display:grid;place-items:center;flex:0 0 var(--card-tag-remove);width:var(--card-tag-remove);min-width:var(--card-tag-remove);height:var(--card-tag-remove);min-height:0;padding:0;font-size:1rem;line-height:1;border-radius:var(--card-tag-radius)}
#creatureGrid .personSelectedName{font-size:inherit;line-height:inherit;overflow-wrap:anywhere}
#creatureGrid .creatureCard>.chips{display:flex;flex:0 1 auto;flex-wrap:wrap;align-items:stretch;gap:var(--card-tag-gap);width:100%;max-width:100%;min-height:0;max-height:none;padding:0 7px 7px;margin:0;overflow-x:hidden;overflow-y:auto;scrollbar-width:thin;box-sizing:border-box}
#creatureGrid .personSelectedOpen{flex-wrap:wrap}
#creatureGrid .personSelectedItem>.itemColorDot{width:11px;height:11px;flex:0 0 11px;margin:0 3px}
#creatureGrid .personLaunch{min-height:36px}
#creatureGrid .creatureCard>.chips:empty{display:none}
#normalSceneDialog{box-sizing:border-box;width:min(100%,640px);max-width:100%;height:auto;max-height:90dvh;inset:auto 0 0;margin:auto auto 0!important;padding:16px 16px calc(18px + env(safe-area-inset-bottom));overflow:hidden;border-radius:23px 23px 0 0}
#normalSceneDialog[open]{display:flex;flex-direction:column;gap:0}
#normalSceneDialog> :not(.candidateList){flex:none;min-width:0}
#normalSceneDialog>.candidateHeader h2{flex:1;min-width:0}
#normalSceneDialog>.candidateHeader button{height:36px;min-height:36px;padding:4px 9px}
#normalSceneTabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:4px 0 8px}
#normalSceneTabs button{min-width:0;height:32px;min-height:32px;padding:3px 2px;font-size:.73rem;white-space:nowrap}
#normalScenePresetRow{display:flex;gap:6px;align-items:center}
#normalScenePresetRow select{flex:1;min-width:0;min-height:36px;height:36px;padding:4px 8px;font-size:.8rem}
#normalScenePresetRow button{height:36px;min-height:36px;padding:4px 12px}
#normalScenePreview{font-size:.7rem;line-height:1.4;margin:5px 0 8px;max-height:3em;overflow:auto}
#normalSceneQuick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;margin:6px 0 0}
#normalSceneQuick button{height:32px;min-height:32px;min-width:0;padding:3px 2px;font-size:.75rem;border-radius:8px}
#normalSceneCount{margin:6px 0;font-size:.78rem;color:var(--muted)}
#normalSceneList{flex:0 1 auto;min-height:80px;overflow-y:auto;overflow-x:hidden;border-block:1px solid var(--border);margin:0 0 8px;overscroll-behavior:contain;touch-action:pan-y}
#normalSceneList .candidateOptionPick{flex:1;min-width:0;text-align:left;min-height:44px;padding:7px 8px;background:transparent;border:0;font-size:.88rem}
#normalSceneDialog>label{font-size:.76rem;color:var(--muted)}
#normalSceneExtra{min-height:38px;height:38px;font-size:.8rem}
.compactScenePreset{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px}
.compactScenePreset select:first-child{grid-column:1/-1}
.compactScenePreset :is(select,button){min-width:0;min-height:36px;height:36px;padding:4px 8px;font-size:.78rem}
.importedSituationPreview{margin:4px 0;font-size:.7rem}
#choiceFoot{flex-wrap:wrap}
@media(max-width:360px){#creatureDialog>.candidateHeader :is(button,.candidateCategoryButton){padding:4px 6px;font-size:.66rem}}

</style><style id="personPlacementLayout">/* The same two-column / three-row card grid in all four placement groups. */
.pgCardGrid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(3,minmax(0,1fr))!important;gap:9px!important;min-width:0;min-height:0;flex:1}
.pgCardGrid>.personPicker{min-width:0;min-height:0;overflow:hidden}
:is(#profiles,#adultDashboard) .pgCardGrid>.uiOff,#adultDashboard.pgCardGrid>.uiOff{display:none!important}
.pgCardGrid>.maintenanceCustomCard{display:flex;flex-direction:column;padding:0;gap:0}
.pgCardGrid>.maintenanceCustomCard>.personLaunch{flex:1;min-height:42px;width:100%;padding:10px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:7px}
.pgCardGrid>.maintenanceCustomCard>.summaryChips{flex:0 1 auto;min-height:0;padding:0 7px 7px;overflow-x:hidden;overflow-y:auto}
@media(max-height:650px){.pgCardGrid{grid-template-rows:repeat(3,minmax(76px,1fr))!important;overflow-y:auto}}

</style><style id="sectionCardsLayout">.scAdditionalActive{overflow-y:auto!important;overflow-x:hidden!important;overscroll-behavior:contain}.scAdditionalActive>.maintenanceProduction{max-height:none;overflow:visible}.scAdditionalActive>#profiles,.scAdditionalActive>#creatureGrid,.scAdditionalActive>#adultDashboard{flex:none}</style>
<style>
/* Custom candidate sheets share the standard list UI; only selected feedback and scoped actions differ. */
#mainCardChoiceDialog .candidateFilters:has(>label:not([hidden])){margin:5px 0}
#mainCardChoiceDialog .candidateFilters:has(>label:not([hidden]))>label:not([hidden]){display:block}
#mainCardChoiceDialog [hidden]{display:none!important}
#mainCardChoiceDialog .candidateFilters:not(:has(>label:not([hidden]))){display:none}
#mainCardChoiceDialog .maCandidateLabel{display:flex;align-items:center;gap:10px;flex:1;min-width:0;min-height:44px;cursor:pointer;overflow-wrap:anywhere}
#mainCardChoiceDialog .maCandidateLabel>input{flex:none;margin:0}
#mainCardChoiceDialog .maPickedCandidate{background:var(--accent-dark);color:var(--accent);border:1px solid var(--accent)}
</style>
<style id="compactCharacterControlRowsV36">
/* Match the two utility rows to the existing person/creature switch. */
#peopleSection{--character-control-height:34px}
#characterKindSwitch>button,
#peopleSection .personBar>select,#peopleSection .personBar>button,
#peopleSection .creatureBar>select,#peopleSection .creatureBar>button,
#peopleSection #characterPresetBar>button,#peopleSection #characterPresetBar>select,
#peopleSection #creaturePresetControls>button,#peopleSection #creaturePresetControls>select{
 height:var(--character-control-height);min-height:var(--character-control-height);box-sizing:border-box;
 padding-top:4px;padding-bottom:4px;line-height:1.2;
}
#peopleSection .personBar,#peopleSection .creatureBar{min-height:0}
#peopleSection #characterPresetBar,#peopleSection #creaturePresetControls{min-height:0;align-items:center}
#peopleSection #characterPresetBar .characterPresetInfo{align-self:center}
</style>

<style id="cardStatusVisibilityV37">
/* Keep status text at its natural line height instead of shrinking it away. */
#profiles .equipmentTile>.equipmentTileLaunch{
 gap:4px;padding:8px;
}
#profiles .equipmentTile>.equipmentTileLaunch>strong,
#profiles .equipmentTile>.equipmentTileLaunch>small,
:is(#profiles,#adultDashboard) .unifiedTagCard>.personLaunch>strong,
:is(#profiles,#adultDashboard) .unifiedTagCard>.personLaunch>small{
 flex-shrink:0;
}
#profiles .equipmentTile>.equipmentTileLaunch>small,
:is(#profiles,#adultDashboard) .unifiedTagCard>.personLaunch>small{
 line-height:1.5;min-height:1.5em;
}
#profiles .equipmentTile>.summaryChips:empty{display:none;padding:0}
#profiles .detailGrid.clothingGrid{
 grid-template-rows:repeat(3,minmax(64px,1fr));
 overflow-y:auto;overscroll-behavior:contain;
}
</style>

<style id="poseCompositionUIV38">
#poseComposeTabs{display:flex;gap:7px;margin:4px 0 8px;flex:none}
#poseComposeTabs[hidden]{display:none}
#poseComposeTabs button{flex:1;min-height:40px;padding:6px}
#poseComposeTabs .active{background:var(--accent-dark);color:var(--accent);border-color:var(--accent)}
#personChoiceDialog[data-pose-compose=true] [data-subject-control=pose]{display:none}
#personChoiceDialog[data-pose-tab=target] #personQuickTabs,
#personChoiceDialog[data-pose-tab=target] #personChoiceFilters,
#personChoiceDialog[data-pose-tab=target] #personSortOpen,
#personChoiceDialog[data-pose-tab=target] #personLegacyCandidates,
#personChoiceDialog[data-pose-tab=target] #personCharacterCandidateControls{display:none!important}
.poseTargetAction{display:block;margin:4px 0 12px}.poseTargetAction select{width:100%;min-height:40px}
.poseTargetChoice{width:100%;text-align:left;min-height:44px;margin:3px 0}
.poseTargetChoice.active{background:var(--accent-dark);color:var(--accent)}
.poseTargetSection{margin-top:12px;font-size:.8rem;color:var(--muted)}
</style>
</head><body><div id="legacy" hidden><header><h1>SeaArt プロンプト作成ツール <small class="edition">成人確認画面を分離</small></h1><p>選択・編集・保存して、SeaArtへコピー</p></header><main><section class="panel" id="settingsPanel"></section></main><nav class="mobileToolbar" aria-label="プロンプト操作"></nav><button id="returnPosition" type="button">元の位置へ戻る ↑</button><div class="row"><h2>画像の内容</h2></div><p class="small">項目名を押すと候補が開きます。検索・複数選択でき、選択済みの名前を押すと解除します。</p><div class="mobileOnly field mobileCategoryLegacy"><label for="mobileCategory">選ぶ項目を切り替え</label><select id="mobileCategory"></select></div><div id="categoryCards" class="mobileOnly categoryCards" aria-label="選ぶ項目"></div><h2>人物ごとの設定</h2><p class="small">キャラクターを選ぶか、オリジナル人物を追加すると設定欄が出ます。衣装・表情・ポーズ・髪型・髪色・目の色・体格を人物ごとに指定できます。髪色は単色・複数色、目は同色・オッドアイに対応。服の部位・装飾品・武器・エフェクトも指定できます。2人以上では人数と左右の位置を自動で指定します。</p><div class="stack"><button id="generate" type="button">プロンプト生成</button><button id="reset" class="secondary" type="button">入力をリセット</button></div><h2>生成結果</h2><p class="small">生成結果は直接編集できます。設定を変えたら「プロンプト生成」を押してください。</p><div class="section"></div><div class="section"></div><div class="row"><h2>カラー漫画ページ</h2><button id="mangaBack" class="secondary" type="button">通常の設定へ</button></div><p class="small">人物設定を共有します。コマごとの登場人物と場面を指定できます。コマ数や配置は生成モデルによってずれる場合があります。</p><h2>コマごとの内容</h2><button id="mangaGenerate" type="button">漫画プロンプトを生成</button></div><header class="appHeader"><div><span class="eyebrow">プロンプト作成</span><h1>SeaArt</h1></div><div class="headerActions"><button id="undoOpen" class="quiet undoHeader" type="button" aria-label="直前の操作を戻す" title="元に戻す" disabled>↶</button><button id="historyOpen" class="quiet" type="button" aria-label="生成履歴を開く">履歴</button><button id="menuOpen" class="quiet" type="button" aria-label="ツールメニュー">☰</button><button id="layoutSettingsOpen" class="hidden" type="button">設定</button><button id="libraryOpen" class="hidden" type="button">保存・データ</button></div></header><dialog id="toolMenu" class="utilityDialog menuSheet"><div class="dialogHead"><h2>ツールメニュー</h2><button type="button" class="quiet" data-close="toolMenu">閉じる</button></div><div class="dialogBody"><h3>設定</h3><button id="menuSettings" class="menuButton" type="button">⚙ 選択画面の設定</button><button id="menuSimpleManga" class="menuButton" type="button">▣ 簡易漫画専用を開く</button><h3>保存</h3><button id="menuFavorites" class="menuButton" type="button">★ お気に入り・設定プリセット</button><h3>データ管理</h3><button id="menuTransfer" class="menuButton" type="button">⇄ Excel・CSV・JSON・バックアップ</button><p class="hint">SeaArt Prompt Tool · Version 2026.09.29</p></div></dialog><nav class="mobileSections" aria-label="設定画面の切り替え"><button type="button" data-mobile-tab="choices" aria-current="page">選択</button><button type="button" data-mobile-tab="people">キャラクター</button><button type="button" data-mobile-tab="finish">仕上げ</button><button type="button" data-mobile-tab="result">結果</button><button type="button" data-mobile-tab="manga">漫画</button></nav><main id="workspaceMain"><div id="choiceSection" class="screen"><div class="screenHead"><div><h2>画像の内容</h2><p>カードを開いて、まとめて選択</p></div><div class="choiceHeadActions"><button id="openSelectedOverview" class="secondary" type="button">選択一覧</button><button id="addOption" class="secondary" type="button">＋ 追加</button></div></div><div id="categorySheet"><div class="sheetHead mobileOnly"><div><span class="sheetEyebrow">選択肢をまとめて選ぶ</span><h2 id="categorySheetTitle">キャラクター</h2></div><button id="closeCategorySheet" type="button" class="secondary">閉じる</button></div><div id="pickers"></div><div class="sheetActions mobileOnly"><button id="prevCategory" type="button" class="secondary">← 前へ</button><button id="addOptionInSheet" type="button" class="secondary" aria-label="この項目に選択肢を追加">＋ 追加</button><button id="nextCategory" type="button">次の項目 →</button><button id="doneCategory" type="button" class="secondary">完了</button></div></div><div class="pager" id="choicePager"><button id="choicePrev" class="quiet" type="button">← 前へ</button><span id="choicePageInfo"></span><button id="choiceNext" class="quiet" type="button">次へ →</button></div><div id="choiceFoot" class="compactRow"><button id="sharedPersonToggle" type="button" class="secondary mobileOnly sharedPersonToggle hidden" aria-expanded="false"></button><button type="button" class="secondary mobileOnly" data-review>設定を確認</button><button type="button" id="toPeople" class="secondary mobileOnly mobileNext">人物を設定 →</button></div></div><div class="screen" id="peopleSection" data-character-kind="person"><div class="screenHead"><div><h2>キャラクター</h2><p>人物と生物を設定</p></div><div class="personHeadActions"><button id="personOverviewOpen" class="quiet" type="button">選択一覧</button><button id="openRelations" class="quiet" type="button">位置・関係</button></div></div><div id="characterKindSwitch" role="group" aria-label="キャラクターの種類"><button type="button" class="secondary active" data-character-kind="person" aria-pressed="true">人物</button><button type="button" class="secondary" data-character-kind="creature" aria-pressed="false" aria-controls="creatureSettings">生物</button></div><div id="creatureSettings" hidden><div class="creatureBar"><select id="creatureSwitch" aria-label="設定する生物"></select><button id="addCreature" class="secondary" type="button">＋ 生物</button><button id="removeCreature" class="quiet" type="button" disabled>削除</button></div><div id="creatureGrid" aria-label="生物の設定"></div></div><div class="personBar"><select id="personSwitch" aria-label="設定する人物"></select><button id="personIdentity" class="quiet" type="button">編集</button><button id="addOriginal" class="secondary" type="button">＋ 人物</button></div><div id="characterPresetBar" class="characterPresetBar" hidden><div class="characterPresetInfo"><strong>キャラ基本設定</strong><small id="characterPresetStatus" aria-live="polite" hidden></small></div><select id="characterPresetSelect" aria-label="キャラ基本設定プリセット" hidden></select><button id="characterPresetApply" class="secondary" type="button" hidden>キャラ基本設定を適用</button></div><div id="personTabs" class="segments" aria-label="人物の設定項目"></div><div id="profiles"></div><div class="section" id="adultSceneSection"><div id="adultSection"><summary>成人向けの場面設定</summary><p id="adultSafetyNote" class="small">登場人物全員が成人であることを確認した場合にだけ、以下の項目をプロンプトへ追加します。年齢が曖昧なキャラクターは使用しないでください。</p><label id="adultEnableWrap" class="negativeChoice"><input id="adultEnabled" type="checkbox"><span>成人向けの場面設定を使う</span></label><div id="adultConfirm"></div><div id="adultFields" class="hidden"><div id="adultPeople"></div><div id="adultBodyPickers" class="profileGrid"></div><div id="adultSharedPickers" class="profileGrid"></div><div class="profileGrid adultSharedLegacy"><div><label for="adultMood">雰囲気</label><select id="adultMood"><option value="">指定なし</option><option value="romantic atmosphere">ロマンチック</option><option value="intimate atmosphere">親密</option><option value="playful atmosphere">いたずらっぽい</option><option value="dramatic atmosphere">ドラマチック</option><option value="candlelit atmosphere">ろうそくの光</option><option value="soft bedroom lighting">柔らかい室内光</option><option value="warm sunset light">夕暮れの温かな光</option><option value="quiet evening atmosphere">静かな夜</option><option value="dreamy atmosphere">夢のような雰囲気</option><option value="cozy indoor atmosphere">落ち着いた室内</option><option value="moonlit atmosphere">月明かり</option><option value="rainy evening by the window">雨の夜の窓辺</option><option value="soft golden lighting">柔らかい金色の光</option><option value="festive atmosphere">祝祭の雰囲気</option><option value="serene atmosphere">穏やかな雰囲気</option></select></div><div><label for="adultPhase">場面の時点</label><select id="adultPhase"><option value="">指定なし</option><option value="before an embrace">抱き合う前</option><option value="during an embrace">抱き合っている</option><option value="after an embrace">抱き合った後</option><option value="quiet moment together">寄り添う静かな場面</option><option value="first meeting">出会いの場面</option><option value="reunion after a long time">久しぶりの再会</option><option value="moment before a kiss">キスの直前</option><option value="sharing a quiet conversation">静かに語り合う</option><option value="slow dance together">ゆっくり踊る</option><option value="watching the sunset together">一緒に夕日を見る</option><option value="resting together afterward">その後に寄り添って休む</option></select></div><div><label for="adultFocus">見せ方</label><select id="adultFocus"><option value="">指定なし</option><option value="full-body view of both adults">二人の全身</option><option value="upper-body view of both adults">二人の上半身</option><option value="balanced focus on both adults">二人を同じ大きさで</option><option value="focus on facial expressions">表情を中心に</option><option value="close-up on both faces">二人の顔のアップ</option><option value="focus on joined hands">つないだ手を中心に</option><option value="over-the-shoulder two-shot">肩越しの二人</option><option value="side profile of both adults">二人の横顔</option><option value="one person in foreground, other in background">手前と奥に配置</option><option value="balanced full-body two-shot">均等な全身ツーショット</option><option value="warm backlit two-shot">逆光のツーショット</option><option value="portrait framing with both adults">二人を収めた肖像構図</option></select></div></div><div class="field"><label for="adultExtra">場面の追加指定（英語）</label><input id="adultExtra" maxlength="500" placeholder="例: warm light, soft shadows"></div></div></div></div><div id="peopleEmpty" class="empty"><span class="emptyMark">＋</span><h3>人物を追加しましょう</h3><p>選択ページでキャラクターを選ぶか、<br>「＋ 人物」からオリジナル人物を作れます。</p><button id="chooseCharacter" type="button">キャラクターを選ぶ</button></div><div id="personPager" class="pager"><button id="personPrev" class="quiet" type="button">← 前へ</button><span id="personPageInfo"></span><button id="personNext" class="quiet" type="button">次へ →</button></div></div><div class="screen" id="finishingSection"><div class="screenHead"><div><h2>仕上げ</h2><p>表現と出力の設定</p></div><button type="button" class="secondary" data-review>設定を確認</button></div><div class="toolGrid"><button class="toolCard" id="finishArt" data-open="artDialog" type="button"><strong>画風・タッチ</strong><span>絵の方向を選ぶ</span><em>開く ↗</em></button><button class="toolCard" id="finishStyle" data-open="styleDialog" type="button"><strong>線・色の表現</strong><span>線・色：指定なし</span><em>開く ↗</em></button><button class="toolCard" id="finishQuality" data-open="qualityDialog" type="button"><strong>品質・ディテール</strong><span>標準</span><em>開く ↗</em></button><button class="toolCard" id="finishWeight" data-open="weightsDialog" type="button"><strong>強調度</strong><span>すべて標準</span><em>開く ↗</em></button><button class="toolCard" data-open="negativeDialog" type="button"><strong>ネガティブ</strong><span>避けたい描写を指定</span><em>開く ↗</em></button><button class="toolCard" data-open="orderDialog" type="button"><strong>出力順</strong><span>カテゴリの順序を変更</span><em>開く ↗</em></button></div><button id="finishExtra" class="secondary wideExtra" data-open="tagsDialog" type="button">＋ 選択肢にない指定を追加</button></div></div><section class="screen" id="resultPanel"><div class="screenHead"><div><h2>生成結果</h2><p>内容は直接編集できます</p></div><button id="resultSave" class="quiet" type="button">★ この結果を保存</button></div><div class="modelControls"><label for="modelFamily">モデル系統<select id="modelFamily"><option value="standard">標準（従来の出力）</option><option value="illustrious">Illustrious</option><option value="anima">Anima</option><option value="sdxl">SDXL（その他）</option><option value="noobai">NoobAI</option><option value="pony">Pony</option><option value="krea">Krea</option></select></label><label for="promptOrderMode">出力順<select id="promptOrderMode"><option value="recommended">モデル別の推奨順</option><option value="custom">自分で並べる</option></select></label></div><p id="resultStats" class="hint" aria-live="polite"></p><p class="hint" id="modelHint">モデル系統を選ぶと生成結果を更新します。個別モデルの推奨設定がある場合はそちらを優先してください。</p><div class="segments"><button data-result="positive" type="button">＋ ポジティブ</button><button data-result="negative" type="button">− ネガティブ</button></div><div class="segments"><button id="resultTextView" type="button" class="active">文章表示</button><button id="resultTagView" type="button">タグ表示</button><button id="resultEdit" type="button">✏️ 直接編集</button></div><p id="manualEditNotice" class="hint hidden">手動編集済み。設定を変えて再生成すると置き換わります。</p><div id="resultTagList" class="tagList hidden"></div><button id="resultBack" type="button" class="secondary">設定を修正 ▾</button><div id="resultDestinations" class="segments hidden"><button data-go="choices" type="button">選択</button><button data-go="people" type="button">キャラクター</button><button data-go="finish" type="button">仕上げ</button></div><div class="field" id="positivePane"><div class="row"><label for="positive">ポジティブプロンプト</label><button class="secondary" data-copy="positive" type="button">コピー</button></div><textarea class="output" id="positive"></textarea></div><div class="field" id="negativePane"><div class="row"><label for="negative">ネガティブプロンプト</label><button class="secondary" data-copy="negative" type="button">コピー</button></div><textarea class="negative" id="negative"></textarea></div></section><section id="mangaPanel" class="screen"><div class="screenHead"><div><h2>カラー漫画</h2><p>人物・生物の設定を共有してコマを作成</p></div></div><div id="mangaFlowNav" class="segments" role="group" aria-label="漫画の制作フロー"><button data-manga-view="setup" type="button">ページ</button><button data-manga-view="story" type="button">ストーリー</button><button data-manga-view="panels" type="button">コマ編集</button><button data-manga-view="output" type="button">結果</button><button data-manga-view="compose" type="button">画像合成</button></div><div id="mangaSetup" class="mangaView"><div class="field"><strong>共通の登場主体</strong><p id="mangaPeople" class="small"></p><p id="mangaCreatures" class="small" hidden></p><button id="mangaEditPeople" class="secondary" type="button">人物・生物設定を編集</button></div><div class="profileGrid"><div class="field"><label for="mangaCount">コマ数</label><select id="mangaCount"></select></div><div class="field"><label for="mangaLayout">コマ割り</label><select id="mangaLayout"></select></div><div class="field"><label for="mangaFormat">ページの向き</label><select id="mangaFormat"><option value="portrait">縦長</option><option value="landscape">横長</option><option value="square">正方形</option></select></div><div class="field"><label for="mangaReading">読む順番</label><select id="mangaReading"><option value="left to right">左から右</option><option value="right to left">右から左</option></select></div></div><div class="field"><label for="mangaFrameStyle">枠の見た目</label><select id="mangaFrameStyle"><option value="subtle">細い線・狭い余白（おすすめ）</option><option value="minimal">線なし・最小の余白</option><option value="standard">従来の太い枠</option></select></div><div id="mangaPreview" class="mangaPreview" aria-label="コマ割りのプレビュー"></div><button id="downloadMangaFrame" type="button" class="secondary">この配置の枠画像をPNG保存</button><p class="small mangaFrameHint">白地に黒い枠だけの画像です。SeaArtで参照画像として使用できます。</p></div><div id="mangaStory" class="mangaView" aria-labelledby="mangaStoryTitle"><div class="mangaStoryHeading"><h3 id="mangaStoryTitle">ストーリー</h3><span id="mangaStoryCount" class="small"></span></div><div id="mangaStoryModeSwitch" class="mangaStoryModeSwitch" role="group" aria-label="内容の設定方法"><button type="button" class="secondary active" data-manga-story-mode="story" aria-pressed="true" aria-controls="mangaStoryFlow">ストーリー</button><button type="button" class="secondary" data-manga-story-mode="scene" aria-pressed="false" aria-controls="mangaStoryScene">シーン構成</button></div><div id="mangaStoryFlow"><p class="small">何が起きるかを選びます。設定済みの場所・カメラは保持します。</p><div class="profileGrid mangaStorySettings" aria-label="ストーリープリセット"><div class="field"><label for="mangaStoryGenre">ジャンル</label><select id="mangaStoryGenre"><option value="">未選択</option></select></div><div class="field"><label for="mangaStoryPattern">出来事</label><select id="mangaStoryPattern" disabled><option value="">未選択</option></select></div></div><button id="mangaStoryPreviewOpen" class="secondary" type="button" disabled>内容をプレビュー</button><p id="mangaStoryHint" class="small" role="status" aria-live="polite"></p><section id="mangaStoryPreview" hidden aria-labelledby="mangaStoryPreviewTitle"><h4 id="mangaStoryPreviewTitle">プレビュー</h4><ol id="mangaStorySteps"></ol><p class="small">各コマの役割・行動・タイミングを変更します。場所・カメラ・人物設定は維持します。</p></section><div class="mangaStoryActions"><button id="mangaStoryApply" type="button" disabled>ストーリーを適用</button><button id="undoMangaStory" type="button" class="secondary" hidden>適用を戻す</button></div><p id="mangaStoryStatus" class="small" role="status" aria-live="polite" hidden></p></div><div id="mangaStoryScene" hidden>
<p class="small">出来事の見せ方・展開を選びます。適用するとコマ内容・コマ数・コマ割りを置き換えます。</p>
<label for="mangaPresetType" class="small">シーン構成の分類</label>
<div id="mangaPagePresetChoices"></div>
<div id="mangaPagePresetPreview" class="section" hidden></div>
<button type="button" id="applyMangaPagePreset" hidden>この構成を適用（現在のコマ内容を置換）</button>
<button id="undoMangaPagePreset" class="quiet" type="button" hidden>適用を戻す</button>
<details class="mangaSceneDetails"><summary>詳細設定</summary>
<p class="small">全コマに共通する状況・出来事・演出を追加します。各コマ固有の内容は「コマ編集」で設定します。</p>
<button type="button" id="normalSceneOpen" class="secondary">ページ共通の場面・演出を追加設定</button>
</details></div></div><div id="mangaPanels" class="mangaView"><p class="hint">ページと同じ配置です。コマをタップして内容を設定します。</p><div id="mangaPanelCards" aria-label="コマの内容を編集"></div></div><div id="mangaCompose" class="mangaView"><p class="hint">各コマをSeaArtで個別に生成し、画像を指定してください。ページ設定の配置で１枚に合成します。</p><div id="composeInfo" class="small"></div><div id="composeSlots"></div><canvas id="composeCanvas" aria-label="合成結果のプレビュー"></canvas><button id="saveComposedPage" type="button">合成した漫画をPNG保存</button><p class="small">画像はこの画面内でのみ保持します。ページを閉じると選び直しになります。</p></div><div id="mangaOutput" class="mangaView"><div id="mangaResults" class="section mangaResultsFlow"><p class="small mangaResultGuide">まずページ全体で生成し、崩れたコマだけ個別生成するのがおすすめです。</p><section class="mangaWholeResult" aria-labelledby="mangaWholeTitle"><div class="mangaResultHeading"><h3 id="mangaWholeTitle">ページ全体</h3><button id="mangaResultGenerate" type="button" class="secondary">生成・再生成</button></div><div class="mangaResultCopyActions"><button type="button" data-manga-copy="mangaPositive">Positiveをコピー</button><button type="button" class="secondary" data-manga-copy="mangaNegative">Negativeをコピー</button></div><p id="mangaPageResultEmpty" class="hint">「生成」で現在の設定からプロンプトを作成できます。</p><details id="mangaPagePromptDetails" class="mangaPromptDetails"><summary>プロンプト本文を確認</summary><div class="field"><label for="mangaPositive">ページ全体・Positive</label><textarea id="mangaPositive" class="output"></textarea></div><div class="field"><label for="mangaNegative">Negative</label><textarea id="mangaNegative" class="negative"></textarea></div></details></section><section class="mangaPanelResults" aria-labelledby="mangaPanelsResultTitle"><h3 id="mangaPanelsResultTitle">コマ別</h3><p class="small">ページ全体の生成で崩れたコマや、作り直したいコマだけ個別に生成できます。</p><p id="mangaIndividualEmpty" class="hint">「生成」でコマ別プロンプトも表示されます。</p><div id="mangaIndividual"></div></section><p id="mangaStatus" class="status" role="status" aria-live="polite"></p><button id="mangaResultCompose" type="button" class="secondary">画像合成へ →</button></div></div></section></main><dialog id="normalSceneDialog" class="utilityDialog candidateDialog" aria-labelledby="normalSceneTitle"><div class="dialogHead candidateHeader"><h2 id="normalSceneTitle">場面・演出</h2><button type="button" class="secondary" data-close="normalSceneDialog">閉じる</button></div><div id="normalScenePresetRow"><select id="normalScenePreset" aria-label="場面プリセット"><option value="">プリセットを選択</option></select><button id="normalSceneApply" type="button" class="secondary" disabled>適用</button></div><p id="normalScenePreview" class="hint"></p><div id="normalSceneTabs" class="simpleTabs" aria-label="場面の分類"></div><label for="normalSceneSearch">候補を検索</label><input id="normalSceneSearch" type="search" placeholder="日本語・英語で検索"><div id="normalSceneQuick" class="quickTabs candidateQuickTabs"><button type="button" data-quick="all">すべて</button><button type="button" data-quick="selected">選択中</button><button type="button" data-quick="favorite">★ お気に入り</button></div><p id="normalSceneCount" class="candidateCount"></p><div id="normalSceneList" class="candidateList"></div><label for="normalSceneExtra">場面の追加指定（英語）</label><input id="normalSceneExtra" maxlength="500" placeholder="細かな指定を入力"></dialog><dialog id="creatureDialog" class="utilityDialog candidateDialog" aria-labelledby="creatureDialogTitle"><div class="dialogHead"><h2 id="creatureDialogTitle">生物の設定</h2><button type="button" class="secondary" data-close="creatureDialog">閉じる</button></div><div id="creatureFieldTabs" class="segments" role="group" aria-label="設定項目"></div><div class="dialogBody"><label id="creatureSearchLabel" for="creatureSearch">候補を検索</label><input id="creatureSearch" type="search" placeholder="日本語・英語で検索"><div id="creatureQuickTabs" class="quickTabs" role="group" aria-label="生物候補の表示"><button type="button" data-quick="all">すべて</button><button type="button" data-quick="selected">選択中</button><button type="button" data-quick="favorite">★ お気に入り</button></div><p id="creatureCandidateCount"></p><div id="creatureChoices"></div></div></dialog><dialog id="editor"><form id="editForm"><h2 id="editorTitle">選択肢を追加</h2><div class="field"><label for="editCategory">項目</label><select id="editCategory"></select></div><div class="field"><label for="editName">日本語の表示名</label><input id="editName" required maxlength="150"></div><div class="field"><label for="editEnglish">英語タグ</label><input id="editEnglish" required maxlength="500"></div><div class="field"><label for="editGroup">作品名・グループ（任意）</label><input id="editGroup" maxlength="100"></div><p id="editError" class="status" role="alert"></p><div class="stack"><button type="submit">保存</button><button type="button" id="cancelEdit" class="secondary">キャンセル</button></div></form></dialog><dialog id="choiceDialog" aria-labelledby="choiceDialogTitle"><div class="row"><h2 id="choiceDialogTitle">項目を選ぶ</h2><button id="choiceSortOpen" type="button" class="secondary" aria-expanded="false" aria-controls="choiceSortMenu">並び順 ▾</button><button id="choiceDialogClose" type="button" class="secondary">閉じる</button><button id="sceneTimeToggle" type="button" class="secondary" hidden>時間帯へ →</button></div><div id="choiceSortMenu" hidden role="group" aria-label="並び順の選択"></div><label for="choiceDialogSearch">候補を検索</label><input id="choiceDialogSearch" type="search" placeholder="日本語・英語で検索"><div id="choiceQuickTabs" class="quickTabs" role="group" aria-label="候補の表示"><button type="button" data-quick="all">すべて</button><button type="button" data-quick="selected">選択中</button><button type="button" data-quick="favorite" aria-label="お気に入り">★ お気に入り</button><button type="button" data-tendency="female" hidden>女性</button><button type="button" data-tendency="male" hidden>男性</button></div><div id="characterFilters" class="characterFilters" hidden>
<div class="characterFilterRow"><label>作品<select id="characterGroup"><option value="">すべての作品</option></select></label><div id="characterGenderWrap" role="group" aria-label="性別で絞り込み"><button type="button" data-gender="女性" aria-pressed="false">女性</button><button type="button" data-gender="男性" aria-pressed="false">男性</button><select id="characterGender" hidden aria-label="性別"><option value="">すべて</option><option value="女性">女性</option><option value="男性">男性</option><option value="性別なし">性別なし</option><option value="不明">性別未登録</option></select></div></div><select id="characterSort" hidden aria-label="並び順"><option value="original">登録順</option><option value="name">名前順</option><option value="group">作品名順</option><option value="gender">女性→男性順</option><option value="selected">選択中を先頭</option></select>

</div><div id="globalHairFilter" class="hairTendencyFilter" hidden><label for="globalHairTendency">スタイルの傾向</label><select id="globalHairTendency"><option value="">すべて</option><option value="メンズ系">メンズ系</option><option value="レディース系">レディース系</option><option value="共通">共通</option></select><span>性別に関係なく選べます</span></div><div id="globalOutfitFilter" class="hairTendencyFilter" hidden><label for="globalOutfitTendency">スタイルの傾向</label><select id="globalOutfitTendency"><option value="">すべて</option><option value="メンズ系">メンズ系</option><option value="レディース系">レディース系</option><option value="共通">共通</option></select><span>性別に関係なく選べます</span></div><div id="characterMatchCount" class="small" aria-live="polite" hidden></div><div id="choiceDialogChoices"></div><div class="field" id="choiceWeightBox"><label for="choiceWeight">この項目の強調度</label><select id="choiceWeight"></select></div><p class="small">選択済みはカードに表示され、×で解除できます。</p></dialog><dialog id="personChoiceDialog" aria-labelledby="personChoiceTitle"><div class="row"><h2 id="personChoiceTitle">人物の設定を選ぶ</h2><button id="personSortOpen" class="secondary" type="button" aria-expanded="false" aria-controls="personSortMenu">並び順 ▾</button><button id="personChoiceClose" class="secondary" type="button">閉じる</button></div><div id="personSortMenu" role="group" aria-label="並び順の選択" hidden></div><label for="personChoiceSearch">候補を検索</label><input id="personChoiceSearch" type="search" placeholder="日本語・英語で検索"><div id="personQuickTabs" class="quickTabs" role="group" aria-label="人物候補の表示"><button type="button" data-quick="all">すべて</button><button type="button" data-quick="selected">選択中</button><button type="button" data-quick="favorite" aria-label="お気に入り">★ お気に入り</button><button type="button" data-tendency="female" hidden>女性</button><button type="button" data-tendency="male" hidden>男性</button></div><div id="personChoiceFilters" class="personChoiceFilters" hidden><label>分類<select id="personChoiceGroup"><option value="">すべて</option></select></label><select id="personChoiceSort" hidden aria-label="並び順"><option value="original">登録順</option><option value="name">名前順</option><option value="group">分類順</option><option value="selected">選択中を先頭</option></select></div><div id="personHairFilter" class="hairTendencyFilter" hidden><label for="personHairTendency">スタイルの傾向</label><select id="personHairTendency"><option value="">すべて</option><option value="メンズ系">メンズ系</option><option value="レディース系">レディース系</option><option value="共通">共通</option></select><span>性別に関係なく選べます</span><label for="personHairKind">種類<select id="personHairKind"><option value="">すべて</option><option value="basic">基本髪型</option><option value="feature">髪の特徴</option></select></label></div><div id="personOutfitFilter" class="hairTendencyFilter" hidden><label for="personOutfitTendency">スタイルの傾向</label><select id="personOutfitTendency"><option value="">すべて</option><option value="メンズ系">メンズ系</option><option value="レディース系">レディース系</option><option value="共通">共通</option></select><span>性別に関係なく選べます</span></div><div id="personChoiceCount" class="small" aria-live="polite" hidden></div><div id="personChoiceChoices"></div><p class="small">複数選択できます。選択中の内容は人物カードに表示されます。</p></dialog><dialog id="sceneChoiceDialog"><div class="row"><h3 id="sceneDialogTitle"></h3><button type="button" id="closeSceneDialog" class="secondary">完了</button></div><input id="sceneChoiceSearch" type="search" placeholder="日本語・英語で検索" aria-label="候補を検索"><div id="sceneChoiceList" class="sceneChoiceList"></div><button type="button" id="doneSceneDialog" class="secondary">選択を完了</button></dialog><dialog id="relationScreen" class="utilityDialog"><div class="dialogHead"><h2>人物の位置・関係</h2><button type="button" class="quiet" data-close="relationScreen">閉じる</button></div><div class="dialogBody"><div id="multiScene"><h2>複数人物の位置・関係・構図</h2><p class="small">各人物の位置は上の人物欄で設定できます。関係や構図は画像全体に適用します。</p><div class="sceneCards"><div class="sceneCard"><button type="button" id="openRelation">関係・動作　未設定</button><div id="relationChips" class="chips"></div><label for="relation" class="hidden">関係・動作</label><select id="relation"><option value="">指定なし</option><option value="friends">友人</option><option value="teammates">仲間</option><option value="rivals">ライバル</option><option value="siblings">兄弟・姉妹</option><option value="partners">パートナー</option><option value="facing each other">向かい合う</option><option value="back to back">背中合わせ</option><option value="holding hands">手をつなぐ</option><option value="talking to each other">会話する</option><option value="fighting side by side">共闘する</option></select></div><div class="sceneCard"><button type="button" id="openMultiComposition">複数人物の構図　未設定</button><div id="compositionChips" class="chips"></div><label for="multiComposition" class="hidden">複数人物の構図</label><select id="multiComposition"><option value="">指定なし</option><option value="side by side composition">横並び</option><option value="face to face composition">向かい合う構図</option><option value="one person in front, another behind">前後に並ぶ</option><option value="balanced group composition">均等に配置</option><option value="full-body group shot">全身の集合写真</option><option value="close-up two-shot">上半身のツーショット</option></select></div></div><div class="field"><label for="relationExtra">関係・構図の追加指定（英語）</label><input id="relationExtra" placeholder="例: the person on the left holds the other's hand"></div></div></div></dialog><dialog id="identityDialog" class="utilityDialog"><div class="dialogHead"><h2>人物の編集</h2><button type="button" class="quiet" data-close="identityDialog">閉じる</button></div><div class="dialogBody"><div id="identityContent"></div></div></dialog><dialog id="styleDialog" class="utilityDialog"><div class="dialogHead"><h2>線・色の表現</h2><button type="button" class="quiet" data-close="styleDialog">閉じる</button></div><div class="dialogBody"><div class="profileGrid"><div class="field"><label for="lineStyle">線の表現</label><select id="lineStyle"><option value="">指定なし</option><option value="clean lineart">くっきりした線画（従来の設定）</option><option value="bold outlines">太くはっきりした線</option><option value="soft lineart">柔らかい線</option><option value="thin lineart">細い線</option><option value="no lineart">線なし</option><option value="painterly rendering">塗り重視・線を控えめに</option></select></div><div class="field"><label for="colorStyle">色の表現</label><select id="colorStyle"><option value="">指定なし</option><option value="vibrant colors">鮮やかな色</option><option value="rich colors">深みのある色</option><option value="soft pastel colors">淡いパステルカラー</option><option value="high contrast colors">高コントラスト</option><option value="soft colors">柔らかい色合い</option><option value="pale colors">淡い色</option><option value="high saturation">高彩度</option><option value="low saturation">低彩度</option><option value="monochrome">白黒</option></select></div></div></div></dialog><dialog id="moodDialog" class="utilityDialog"><div class="dialogHead"><h2>雰囲気・演出</h2><button data-close="moodDialog" class="quiet">閉じる</button></div><div id="moodChoices" class="dialogBody"></div></dialog><dialog id="artDialog" class="utilityDialog"><div class="dialogHead"><h2>画風・タッチ</h2><button type="button" class="quiet" data-close="artDialog">閉じる</button></div><div class="dialogBody"><div id="artChoices"></div></div></dialog><dialog id="qualityDialog" class="utilityDialog"><div class="dialogHead"><h2>品質・ディテール</h2><button type="button" class="quiet" data-close="qualityDialog">閉じる</button></div><div class="dialogBody"><h3>品質</h3><div id="qualityLevel" class="segments"></div><h3>描き込み</h3><div id="detailLevel" class="segments"></div><h3>重点（複数可）</h3><div id="qualityFocus" class="segments wrap"></div></div></dialog><dialog id="tagsDialog" class="utilityDialog"><div class="dialogHead"><h2>追加の指定</h2><button type="button" class="quiet" data-close="tagsDialog">閉じる</button></div><div class="dialogBody"><div class="field"><label for="extra">追加の英語タグ</label><textarea id="extra" placeholder="例: cinematic light, detailed scenery"></textarea><div id="extraChips" class="chips" aria-label="追加した指定"></div></div><div class="field"><label for="customCharacter">簡易的に名前だけ追加（英語・任意）</label><input id="customCharacter" placeholder="例: Original Character"><p class="hint">衣装や外見まで設定する場合は、上の「オリジナル人物を追加」を使用してください。</p></div></div></dialog><dialog id="weightsDialog" class="utilityDialog"><div class="dialogHead"><h2>強調度</h2><button type="button" class="quiet" data-close="weightsDialog">閉じる</button></div><div class="dialogBody"><div class="detailBox" open=""><summary>選択中の項目の重み</summary><p class="small">1.0が通常です。上げるとその項目を強調します。使うモデルによって効き方は異なります。</p><div id="weightControls" class="weightList"></div><button id="resetAllWeights" class="secondary menuButton" type="button">すべての重みを1.0に戻す</button></div><div class="detailBox" open=""><summary>キャラ名の共通重み</summary><p class="small">個別に重みを指定していない人物に適用します。</p><div class="field"><label for="weight">キャラ名の重み <span id="weightValue">1.0</span></label><input type="range" id="weight" min="1" max="1.8" step="0.1" value="1.0"></div></div></div></dialog><dialog id="negativeDialog" class="utilityDialog"><div class="dialogHead"><h2>ネガティブ</h2><button type="button" class="quiet" data-close="negativeDialog">閉じる</button></div><div class="dialogBody"><div open=""><summary>ネガティブ項目を選ぶ</summary><div id="negativePresets" class="segments negativePresetBar" aria-label="ネガティブプリセット"><button type="button" data-negative-preset="standard">標準</button><button type="button" data-negative-preset="light">軽め</button><button type="button" data-negative-preset="custom">カスタム</button></div><div class="segments"><button id="negativeExpand" type="button">すべて展開</button><button id="negativeCollapse" type="button">すべて閉じる</button></div><div id="negativeChoices"></div><p class="hint">選択を変えたら「プロンプト生成」を押してください。直接編集した文章は生成時に置き換わります。</p></div></div></dialog><dialog id="layoutSettingsDialog" class="utilityDialog" aria-labelledby="layoutSettingsTitle"><div class="dialogHead"><h2 id="layoutSettingsTitle">選択画面の設定</h2><button type="button" class="quiet" data-close="layoutSettingsDialog">閉じる</button></div><div class="dialogBody"><p class="small">順序と表示を変更できます。非表示でも選択済みの設定は保持され、プロンプトに反映されます。変更は自動保存されます。</p><div id="selectionOrderList" aria-label="選択項目の表示順"></div><button id="resetSelectionOrder" class="secondary" type="button">順序・表示をデフォルトに戻す</button><p id="layoutSettingsStatus" class="small" role="status"></p></div></dialog><dialog id="orderDialog" class="utilityDialog"><div class="dialogHead"><h2>出力順</h2><button type="button" class="quiet" data-close="orderDialog">閉じる</button></div><div class="dialogBody"><div open=""><summary>プロンプトの順番を変更</summary><p class="small">優先したい項目を上に移動します。人物の設定は「キャラクター」に含まれます。</p><div id="order"></div><button id="resetOutputOrder" type="button" class="secondary menuButton">出力順をデフォルトに戻す</button></div></div></dialog><dialog id="libraryDialog" class="utilityDialog"><div class="dialogHead"><h2>保存・データ</h2><button type="button" class="quiet" data-close="libraryDialog">閉じる</button></div><div class="dialogBody"><div class="segments"><button data-library="favorites" type="button">お気に入り</button><button data-library="transfer" type="button">データ移動</button></div><div class="section" id="favoritesPane"><h2>お気に入り</h2><label for="favoriteName">保存名</label><input id="favoriteName" placeholder="例: 和服・桜・微笑み" maxlength="100"><button id="saveFavorite" style="margin-top:10px" type="button">名前を付けて保存</button><label for="favorites" style="margin-top:16px">保存した設定</label><select id="favorites"></select><div class="stack" style="margin-top:10px"><button id="loadFavorite" class="secondary" type="button">呼び出す</button><button id="deleteFavorite" class="secondary" type="button">削除</button></div></div><div class="section" id="transferPane"><h2>データの移動</h2><button id="exportAllExcel" type="button" style="width:100%;margin:8px 0">設定・全項目をExcelで書き出す</button><div class="stack"><button id="exportData" class="secondary" type="button">JSONバックアップ</button><button id="importData" class="secondary" type="button">JSONを読み込む</button></div><input id="backupFile" type="file" accept=".json,application/json" class="hidden"><div class="field"><label for="allImportCategory">Excel・CSVを取り込む／書き出す項目</label><select id="allImportCategory"></select><p class="hint">1列目＝日本語の表示名、2列目＝英語タグ、3列目＝グループ名（任意）。.xlsx・.csv・.tsvに対応します。</p><input id="allImportFile" type="file" accept=".xlsx,.csv,.tsv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"><button id="importAllExcel" class="secondary" type="button" style="width:100%;margin-top:10px">選択肢を追加</button><div class="stack" style="margin-top:8px"><button id="exportCategoryExcel" class="secondary" type="button">この項目をExcelで書き出す</button><button id="exportCategoryCsv" class="secondary" type="button">この項目をCSVで書き出す</button></div></div><p class="note">Excelには全項目の選択肢、現在の設定、生成済みプロンプト、お気に入り名を別シートで書き出します。Excelから選択肢を取り込む際は、項目ごとのファイルを使ってください。設定全体を復元する場合はJSONバックアップをご利用ください。</p><p id="storageStatus" class="status" role="status"></p></div></div></dialog><dialog id="mangaSceneDialog" class="utilityDialog"><div class="dialogHead"><h2 id="mangaSceneTitle">候補を選ぶ</h2><button type="button" class="quiet" data-close="mangaSceneDialog">閉じる</button></div><div class="dialogBody"><input id="mangaSceneSearch" type="search" placeholder="日本語・英語で検索" aria-label="候補を検索"><div id="mangaSceneList"></div></div></dialog><dialog id="mangaEditDialog" class="utilityDialog" aria-labelledby="mangaEditTitle"><div class="dialogHead"><h2 id="mangaEditTitle">コマを編集</h2><button type="button" class="quiet" data-close="mangaEditDialog">完了</button></div><div id="mangaEditTabs" role="tablist" aria-label="コマ編集の分類"><button id="mangaEditTab-scene" type="button" class="secondary" role="tab" data-manga-edit-group="scene"><span>場面</span><span class="mangaEditDot" aria-hidden="true" hidden></span></button><button id="mangaEditTab-people" type="button" class="secondary" role="tab" data-manga-edit-group="people"><span>人物・生物</span><span class="mangaEditDot" aria-hidden="true" hidden></span></button><button id="mangaEditTab-composition" type="button" class="secondary" role="tab" data-manga-edit-group="composition"><span>構図</span><span class="mangaEditDot" aria-hidden="true" hidden></span></button><button id="mangaEditTab-effects" type="button" class="secondary" role="tab" data-manga-edit-group="effects"><span>演出</span><span class="mangaEditDot" aria-hidden="true" hidden></span></button><button id="mangaEditTab-details" type="button" class="secondary" role="tab" data-manga-edit-group="details"><span>詳細</span><span class="mangaEditDot" aria-hidden="true" hidden></span></button></div><div class="dialogBody"></div><div class="mangaEditNav"><button type="button" id="mangaEditPrev" class="secondary">← 前のコマ</button><button type="button" id="mangaEditNext" class="secondary">次のコマ →</button></div></dialog><dialog id="personOptionEditor" class="personOptionEditor" aria-labelledby="personOptionEditorTitle"><form id="personOptionEditForm"><h2 id="personOptionEditorTitle">人物の選択肢を編集</h2><label>日本語名<input id="personEditName" required></label><label>英語タグ<input id="personEditEnglish" required></label><label>分類（任意）<input id="personEditGroup"></label><p id="personEditError" class="small" role="alert"></p><div class="row"><button type="button" class="secondary" id="personOptionEditCancel">キャンセル</button><button type="submit">保存</button></div></form></dialog><dialog id="selectedOverviewDialog" aria-labelledby="selectedOverviewTitle"><div class="dialogHead"><h2 id="selectedOverviewTitle">選択一覧</h2><button type="button" class="quiet" id="selectedOverviewClose">閉じる</button></div><div class="overviewTools"><p class="overviewHint">強度を押すと 共通 → 強調 → 強く → 通常</p><label class="overviewShowAll"><input id="overviewShowAll" type="checkbox">未設定も表示</label></div><div id="selectedOverviewBody" class="reviewBody"></div><div class="overviewFoot"><button type="button" id="selectedOverviewDone">完了</button></div></dialog><dialog id="reviewDialog" aria-labelledby="reviewTitle"><div class="dialogHead"><h2 id="reviewTitle">生成前の設定確認</h2><button type="button" class="quiet" id="reviewClose">閉じる</button></div><div id="reviewBody" class="reviewBody"></div><div class="reviewActions"><button type="button" class="secondary" id="reviewChoices">選択を編集</button><button type="button" class="secondary" id="reviewPeople">人物を編集</button><button type="button" id="reviewGenerate">この設定で生成</button></div></dialog><footer class="actionBar"><button id="mobileGenerate" type="button">生成</button><button id="mobileCopy" class="secondary" type="button" aria-label="Positive Promptをコピー">＋ コピー</button><button id="mobileCopyNegative" class="secondary" type="button" aria-label="Negative Promptをコピー">− コピー</button><button id="mobileReset" class="secondary" type="button">リセット</button></footer><p id="status" class="status toast" role="status" aria-live="polite"></p><script>@@SEAART_SCRIPT_00@@</script>

<style id="candidateOrganizationUI">
.maintenanceCandidate>.maintenanceOptionOpen{border:0;border-radius:0;background:transparent;padding:8px 4px}
#personCharacterCandidateControls{flex:none;flex-wrap:wrap;gap:5px}#personCharacterCandidateControls>button{font-size:.73rem;padding:5px 8px;min-height:34px}#personCharacterCandidates.active{border-color:var(--accent);color:var(--accent);background:var(--accent-dark)}
</style>
<style id="recoveryUITransplant">
.maintenanceDialog{width:min(640px,calc(100vw - 16px));max-width:calc(100vw - 16px);max-height:92dvh;height:auto;padding:0;overflow:hidden;box-sizing:border-box}.maintenanceDialog[open]{display:flex;flex-direction:column}.maintenanceDialog>.dialogHead,.maintenanceDialog>.candidateHeader{flex:none;margin:0;padding:12px 14px;border-bottom:1px solid var(--border);gap:6px}.maintenanceDialog h2{font-size:1rem;margin:0;min-width:0;flex:1}.maintenanceDialog>.dialogBody,.maintenanceDialog>.candidateList{flex:1 1 auto;min-height:0;overflow:auto;overflow-x:hidden;overscroll-behavior:contain;padding:12px 14px}.maintenanceTabs,.maintenanceGroups{display:flex;gap:5px;flex:none;margin:8px 0}.maintenanceDialog>.maintenanceTabs{padding:0 14px}.maintenanceTabs>button,.maintenanceGroups>button{flex:1;min-width:0;min-height:38px;padding:6px 3px;font-size:.78rem;white-space:nowrap}.maintenanceTabs>button.active,.maintenanceGroups>button.active{background:#5652b6;color:#fff}.maintenanceFooter{display:flex;gap:8px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--border);flex:none}.maintenanceFooter button{flex:1;min-height:44px}.maintenanceField{display:block;font-size:.82rem;margin:8px 0}.maintenanceField>input,.maintenanceField>select,.maintenanceField>textarea{display:block;width:100%;box-sizing:border-box;margin:4px 0;max-width:100%}.maintenanceRow{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;width:100%;min-height:44px;margin:6px 0;padding:9px 11px;box-sizing:border-box}.maintenanceRow>span{min-width:0;overflow-wrap:anywhere}.maintenanceRow small{font-size:.68rem;color:var(--muted);flex:none}.maintenanceActions{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.maintenanceActions>button{min-height:40px;padding:7px 10px;font-size:.8rem}.maintenanceActions input{min-width:0;width:100%}.maintenanceCandidate{display:flex;gap:6px;margin:0;border:0;border-bottom:1px solid var(--border);border-radius:0;overflow:hidden}.maintenanceOptionOpen{display:flex;align-items:center;gap:8px;flex:1;min-width:0;text-align:left;min-height:44px;padding:8px 10px}.maintenanceOptionOpen>span{min-width:0;overflow-wrap:anywhere}
#mainCardChoiceDialog .maintenanceOptionOpen[aria-pressed=true]{background:var(--accent-dark);color:var(--accent);border-color:var(--accent)}
.maintenanceOptionOpen small{display:block;font-size:.68rem;color:var(--muted);margin-top:3px;overflow-wrap:anywhere}.maintenanceLinkChip{font-size:.75rem;margin:3px;padding:6px}.maintenanceLinkList{margin:12px 0}.maintenanceToast{position:fixed;bottom:calc(64px + env(safe-area-inset-bottom));left:8px;right:8px;max-width:620px;margin:auto;z-index:10002;padding:8px 10px;border:1px solid var(--border);background:#293143;border-radius:10px;display:flex;gap:8px;align-items:center;box-shadow:0 4px 18px #0007;font-size:.8rem}.maintenanceToast[hidden]{display:none}.maintenanceToast>span{flex:1;min-width:0}.maintenanceToast button{min-height:42px;flex:none;padding:6px 8px}.maintenanceProduction{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;flex:none;max-height:180px;overflow:auto}.maintenanceProduction[hidden]{display:none!important}.maintenanceCustomCard{min-width:0;padding:6px;box-sizing:border-box}.maintenanceCustomCard .personLaunch{width:100%;min-height:44px}.maintenanceCustomCard .summaryChips{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}.maintenanceCustomCard .summaryChip{display:inline-flex;max-width:100%;padding:3px;font-size:.72rem;background:#343254;border-radius:6px}.maintenanceCustomCard .summaryChipName{min-width:0;overflow-wrap:anywhere;padding:2px;font-size:.7rem;min-height:30px}.maintenanceCustomCard .summaryChipRemove{min-height:30px;padding:0 5px;flex:none}.maintenanceHidden{display:none!important}#peopleSection[data-character-kind=creature]>.maintenanceProduction{display:none!important}#maintenancePickDialog>input{margin:3px 14px;width:calc(100% - 28px);box-sizing:border-box}.maintenanceDialog [hidden]{display:none!important}

#editor.maintenanceDialog,#personOptionEditor.maintenanceDialog{padding:0!important;width:min(640px,calc(100vw - 16px));max-width:calc(100vw - 16px);max-height:92dvh;border-radius:23px}
#editor.maintenanceDialog>form,#personOptionEditor.maintenanceDialog>form{display:flex;flex-direction:column;flex:1;min-height:0;height:100%;margin:0;padding:0!important;overflow:hidden}
.ruFormDialog .maintenanceFooter button{background:var(--raised);color:var(--text);border-color:var(--border)}
.ruFormDialog>form{display:flex;flex-direction:column;flex:1;min-height:0;height:100%;margin:0;padding:0;overflow:hidden}
.ruFormDialog>form>.dialogHead{flex:none;margin:0;padding:12px 14px;border-bottom:1px solid var(--border);gap:6px;display:flex;align-items:center;justify-content:space-between}
.ruFormDialog>form>.dialogHead h2{font-size:1rem;margin:0;min-width:0;flex:1}
.ruFormDialog>form>.dialogBody{flex:1;min-height:0;overflow:auto;overflow-x:hidden;padding:12px 14px;overscroll-behavior:contain}
.ruExistingField{margin:8px 0;font-size:.82rem}.ruExistingField>.maintenanceField{margin:0}.ruExistingField>input,.ruExistingField>select,.ruExistingField>textarea{display:block;width:100%;max-width:100%;box-sizing:border-box;margin:4px 0 0;font-size:inherit}.ruFormDialog .maintenanceActions~.maintenanceActions{display:none}
.ruFormDialog .maintenanceFooter button{width:100%}
#mainMaintenanceDialog .mbAuditGroup>.maField{display:block}
#maintenanceEditDialog .maLinkChoices{max-height:none;overflow:visible;padding:0;border:0}
#maintenanceEditDialog .maLinkChoices>button{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;width:100%;min-height:44px;margin:0;padding:7px 4px;box-sizing:border-box;background:var(--raised);color:var(--text);border:0;border-bottom:1px solid var(--border);border-radius:0}
#maintenanceEditDialog .maRefList{max-height:none;overflow:visible}
#mainCardChoiceDialog .modalOption>select{width:67px;min-height:38px;flex:none;padding:6px}
#mainCardChoiceDialog .modalOption>.quickStar{flex:none}
.maintenanceDialog .dialogBody{max-height:none}
</style>
