<!DOCTYPE html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SeaArt プロンプト作成ツール</title><style>:root{color-scheme:dark;--bg:#10151e;--surface:#1a2230;--raised:#222e3e;--border:#344358;--text:#f1f5fa;--muted:#a1b1c8;--accent:#83e2cf;--accent-dark:#164a43;--radius:15px;font-family:system-ui,-apple-system,'Noto Sans JP',sans-serif;font-size:15px}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;overscroll-behavior:none}body{height:100dvh;display:flex;flex-direction:column;background:var(--bg);color:var(--text);padding:env(safe-area-inset-top) 0 0}button,input,select,textarea{font:inherit;color:inherit}button{border:1px solid transparent;border-radius:11px;min-height:44px;padding:10px 13px;background:var(--accent);color:#102b29;font-weight:700;cursor:pointer;touch-action:manipulation}button:hover{filter:brightness(1.08)}button:disabled{opacity:.35;cursor:default}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.quiet,.secondary,.edit,.tiny{background:var(--raised);border-color:var(--border);color:var(--text)}.tiny{min-height:32px;padding:5px 9px;font-size:.74rem}input:not([type=checkbox]):not([type=range]),select,textarea{border:1px solid var(--border);border-radius:10px;background:#111a27;width:100%;padding:11px;min-height:44px}input[type=checkbox]{width:22px;height:22px;accent-color:var(--accent);flex:none}input[type=range]{width:100%;accent-color:var(--accent)}textarea{resize:none;line-height:1.65}label{display:block;font-size:.82rem;color:var(--muted);margin:5px 0 7px}h1,h2,h3,p{margin:0}h2{font-size:1.16rem}h3{font-size:1rem}.small,.hint,.note{color:var(--muted);font-size:.78rem;line-height:1.65}.field{margin:12px 0}.hidden,[hidden],.uiOff{display:none!important}.appHeader{height:61px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:9px 17px;border-bottom:1px solid #263245}.appHeader h1{font-size:1.12rem;letter-spacing:.02em}.eyebrow{font-size:.55rem;letter-spacing:.18em;color:var(--accent);display:block;margin-bottom:1px}.appHeader button{font-size:.76rem;min-height:36px}.mobileSections{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;flex:none;padding:7px 10px;background:var(--bg)}.mobileSections button{background:transparent;color:var(--muted);font-size:.82rem;padding:7px 3px;min-height:42px}.mobileSections button[aria-current=page]{background:var(--accent-dark);color:var(--accent);border-color:#366a63}
#workspaceMain{flex:1;min-height:0;overflow:hidden;padding:4px 12px 10px;width:100%;max-width:960px;margin:0 auto}.screen{display:none;height:100%;min-height:0;overflow:hidden;flex-direction:column;gap:10px}body[data-mobile-tab=choices] #choiceSection,body[data-mobile-tab=people] #peopleSection,body[data-mobile-tab=finish] #finishingSection,body[data-mobile-tab=result] #resultPanel,body[data-mobile-tab=manga] #mangaPanel{display:flex}.screenHead{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:none;padding:8px 2px}.screenHead p{font-size:.73rem;color:var(--muted);margin-top:5px}.screenHead button{font-size:.75rem;min-height:38px}.actionBar{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:6px;padding:9px 12px calc(9px + env(safe-area-inset-bottom));border-top:1px solid var(--border);background:var(--bg);flex:none}.actionBar button{font-size:.75rem;padding:10px 3px;min-height:47px}.actionBar button:not(:first-child){background:var(--raised);color:var(--text)}.toast{position:fixed;bottom:calc(78px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:max-content;max-width:90%;background:#e0f8ee;color:#14352d;border-radius:9px;font-size:.73rem;padding:9px 12px;z-index:100;pointer-events:none;opacity:0;transition:opacity .15s}.toast.visible{opacity:1}
#categorySheet{flex:1;min-height:0;overflow:hidden}.sheetHead,.sheetActions,#categoryCards,.mobileCategoryLegacy,#categorySheet .picker>details{display:none!important}#pickers{height:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(var(--grid-rows,3),minmax(0,1fr));gap:9px;align-content:start}.picker{border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);min-width:0;display:flex;flex-direction:column;overflow:hidden}.choiceLaunch{flex:1;min-height:42px;background:transparent;color:var(--text);text-align:left;font-size:.88rem;padding:11px;overflow-wrap:anywhere;font-weight:650}.picker.hasSelection{border-color:#59837e;background:#1e343a}.weightStep{background:transparent;color:var(--accent);border:0;border-top:1px solid #ffffff0b;text-align:left;font-size:.71rem;padding:5px 10px;min-height:29px;border-radius:0}.chips{display:flex;gap:4px;padding:0 8px 8px;min-width:0;overflow:hidden;flex-wrap:nowrap}.chip{background:#304654;color:#ccebe8;font-size:.68rem;font-weight:500;padding:4px 7px;min-height:29px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;max-width:100%;min-width:0;flex-shrink:1}.chips .chip:nth-child(n+3){display:none}.pager{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:none}.pager button{min-height:36px;font-size:.74rem;padding:7px 13px}.pager span{font-size:.72rem;color:var(--muted);text-align:center}.compactRow{display:flex;gap:8px;flex:none}.compactRow button{min-height:32px;padding:6px 9px;font-size:.7rem;flex:1}.sharedPersonToggle{color:var(--muted);background:transparent;border:1px dashed var(--border)}
.personBar{display:flex;gap:6px;flex:none}.personBar select{flex:1;width:0;min-width:0;font-size:.85rem}.personBar button{font-size:.73rem;white-space:nowrap;padding:8px}.segments{display:flex;gap:5px;flex:none}.segments button{flex:1;min-width:0;min-height:37px;padding:7px 3px;border-radius:9px;background:var(--surface);color:var(--muted);font-size:.74rem}.segments button.active{background:var(--accent-dark);color:var(--accent);border-color:#3b6b64}#personTabs{display:grid;grid-template-columns:repeat(5,1fr)}#profiles{flex:1;min-height:0;overflow:hidden}#profiles>.profile{height:100%}#profiles>.profile>summary,.personGroup>summary,.detailBox>summary{display:none}#profiles .personContent{height:100%;min-height:0;display:flex;flex-direction:column;gap:6px}#profiles .personGroup,#profiles .detailBox{height:100%;min-height:0;display:flex;flex-direction:column;gap:6px}.profileGrid,.detailGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;min-width:0}#profiles .profileGrid,#profiles .detailGrid{flex:1;min-height:0;grid-template-rows:repeat(var(--person-rows,3),minmax(0,1fr));overflow:hidden}#profiles .profileGrid>div,#profiles .detailGrid>div{min-width:0;min-height:0}#profiles .profileGrid>div:not(.personPicker){padding:9px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}#profiles .detailGrid>div{display:flex;flex-direction:column}#profiles .detailGrid>div>.personPicker{height:100%}.personPicker{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);min-height:0;min-width:0;display:flex;flex-direction:column;overflow:hidden}.personPicker>details{display:none!important}.personLaunch{background:transparent;color:var(--text);flex:1;min-height:42px;font-size:.8rem;text-align:left;padding:10px;overflow-wrap:anywhere}.personPicker .chips{padding:0 7px 7px}#profiles .profileGrid select{font-size:.78rem;padding:8px;min-height:37px}#profiles .profileGrid label{font-size:.74rem;margin:0 0 5px}#profiles .negativeChoice{margin:0;font-size:.72rem;min-height:30px}.negativeChoice,.mangaCheck{display:flex;align-items:center;gap:9px;color:var(--text);padding:9px;background:var(--surface);border-radius:9px;font-size:.82rem}.empty{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:15px}.empty p{font-size:.83rem;line-height:1.8;color:var(--muted)}.emptyMark{display:grid;place-items:center;width:65px;height:65px;border-radius:20px;background:var(--accent-dark);color:var(--accent);font-size:30px}
#adultSceneSection{flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column}#adultSection{display:flex;flex-direction:column;min-height:0;height:100%;gap:8px}#adultSection>summary{display:none}#adultFields,#adultPeople,#adultPeople>.profile{flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:7px}#adultPeople h3{font-size:.8rem;color:var(--muted)}#adultPeople .profileGrid,#adultSharedPickers{grid-template-rows:repeat(3,minmax(0,1fr));flex:1;min-height:0}#adultSharedPickers{grid-template-rows:repeat(2,minmax(0,1fr))}.adultSharedLegacy{display:none}#adultConfirm{overflow:auto;min-height:0}#adultSafetyNote{background:var(--surface);padding:12px;border-radius:12px}#adultEnabled{margin:0}#adultFields>.field{margin:0}#adultExtra{min-height:40px}.adultNav{margin-bottom:7px}#adultPeople .profileGrid>div:not(.personPicker){padding:8px;background:var(--surface);border:1px solid var(--border);border-radius:12px}#adultPeople select{min-height:38px;font-size:.75rem;padding:5px}
.toolGrid{flex:1;min-height:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:10px}.toolCard{background:var(--surface);border:1px solid var(--border);text-align:left;color:var(--text);padding:14px;display:flex;flex-direction:column;gap:9px;min-height:0}.toolCard strong{font-size:.92rem}.toolCard span{font-size:.74rem;line-height:1.6;color:var(--muted);font-weight:400}.toolCard em{color:var(--accent);font-size:.7rem;font-style:normal;margin-top:auto}#positivePane,#negativePane{flex:1;min-height:0;display:flex;flex-direction:column;margin:0;gap:8px}#resultPanel .output,#resultPanel textarea{flex:1;min-height:0;font-size:.88rem}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.row button{flex:none}#resultPanel .row label{margin:0}.orderRow{display:flex;align-items:center;gap:7px;margin:8px 0}.orderRow span{flex:1}.orderRow button{min-height:34px;padding:5px 12px}
/* Dialogs are the only vertically scrolling settings surfaces. */
dialog{background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:23px 23px 0 0;width:min(100%,640px);max-width:none;max-height:92dvh;margin:auto auto 0;padding:16px 16px calc(18px + env(safe-area-inset-bottom));overflow:auto;overscroll-behavior:contain;box-shadow:0 -20px 80px #0007}dialog::backdrop{background:#02080dc9}dialog>form{margin:0}.dialogHead,dialog>.row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}.dialogHead h2,dialog>.row h2,dialog>.row h3{font-size:1rem;line-height:1.6;max-width:75%}.dialogHead button,dialog>.row button{min-height:39px;font-size:.78rem;padding:8px 12px}dialog .small{margin-top:10px}dialog .stack{display:flex;gap:7px;flex-wrap:wrap}dialog .stack button{flex:1;font-size:.8rem}dialog details>summary{display:none}dialog details{display:block}dialog input[type=search]{position:sticky;top:0;z-index:2}#choiceDialogChoices,#personChoiceChoices,#sceneChoiceList{max-height:48dvh;overflow:auto;overscroll-behavior:contain;margin:10px 0;border-block:1px solid var(--border);scrollbar-width:thin}.modalOption{display:flex;align-items:center;gap:10px;padding:12px 2px;min-height:52px;margin:0;border-bottom:1px solid #263245;color:var(--text);font-size:.88rem}.modalOption span{flex:1;min-width:0;overflow-wrap:anywhere}.modalOption:last-child{border-bottom:0}.modalOption input{margin:0}#personCustomField{padding:8px 0;margin:6px 0}#personCustomField label{margin:2px 0 6px}#personCustomClear{min-height:30px;padding:5px 9px;font-size:.73rem;margin-top:6px}#personChoiceDialog.hasCustom #personChoiceChoices{max-height:33dvh}#choiceWeightBox{margin:8px 0}#choiceWeightBox select{min-height:36px;font-size:.8rem}#sceneChoiceDialog .sceneCards{display:none}.sceneCards{display:grid;grid-template-columns:1fr 1fr;gap:10px}.sceneCard{padding:10px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.sceneCard>button{background:transparent;color:var(--text);padding:5px;text-align:left}.sceneCard select{display:none}.sceneCard .chips{flex-wrap:wrap;padding:8px 0}.sceneCard .chip:nth-child(n){display:block}#multiScene>h2{display:none}#multiScene>.small{margin-bottom:12px}#weightControls{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}#negativeChoices .negativeChoice{margin:7px 0}#identityContent>.profileGrid{margin-bottom:14px}#identityContent>.profileGrid label{font-size:.82rem}.status{font-size:.8rem;line-height:1.6}#storageStatus{margin-top:12px;color:var(--accent)}#transferPane>.note{margin-top:16px}#favoritesPane>h2,#transferPane>h2{display:none}#libraryDialog .segments{margin-bottom:18px}
.mangaView{flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:10px}#mangaSetup>.field{margin:0}#mangaPeople{font-size:.73rem;margin:4px 0;max-height:36px;overflow:hidden;color:var(--muted)}#mangaEditPeople{font-size:.7rem;min-height:32px;padding:5px 9px}#mangaSetup .profileGrid{gap:7px}#mangaSetup label{font-size:.74rem;margin:0 0 5px}.mangaPreview{display:grid;gap:6px;flex:1;min-height:60px;padding:10px;background:#192531;border-radius:14px}.mangaPreview span{display:grid;place-items:center;border:1px solid #548476;background:#23483e;border-radius:7px;font-size:.74rem;color:#bbebd7}#mangaPanelCards{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,minmax(0,1fr));gap:10px;flex:1;min-height:0}.mangaCard{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden}.mangaCard>summary{list-style:none;font-size:.83rem;line-height:1.65;padding:13px;cursor:pointer;height:100%}.mangaCard>div{display:none}#mangaEditDialog .dialogBody>div{display:block!important}.mangaPerson{border-top:1px solid var(--border);margin-top:14px;padding-top:10px}.mangaPanelSubjectFields{grid-column:1/-1;display:flex;flex-direction:column;gap:8px;min-width:0}.mangaPersonFields>.field:has(+.mangaPanelSubjectFields){grid-column:1/-1}.mangaPersonFields{display:grid;grid-template-columns:1fr 1fr;gap:8px}.mangaPersonFields>.field:last-child{grid-column:1/-1}#mangaOutput{overflow:auto}#mangaResults>h2{display:none}#mangaResults textarea{min-height:180px}.mangaIndividual{margin-top:16px}#mangaResults .row button{min-height:32px;font-size:.72rem;padding:6px 10px}
@media(min-width:700px){.appHeader{padding-inline:max(20px,calc((100vw - 940px)/2))}.mobileSections{max-width:960px;width:100%;align-self:center}.actionBar{padding-inline:max(20px,calc((100vw - 940px)/2))}.picker .choiceLaunch,.personLaunch{font-size:1rem}.screen{padding:8px 0}dialog{margin:auto;border-radius:22px}}
@media(max-height:680px){.appHeader{height:49px}.screenHead{padding:3px 0}.screenHead p{display:none}.mobileSections{padding:3px 10px}.mobileSections button{min-height:36px}.screen{gap:7px}.actionBar{padding-top:6px;padding-bottom:calc(6px + env(safe-area-inset-bottom))}.actionBar button{min-height:42px}.choiceLaunch,.personLaunch{font-size:.76rem;padding:8px}.chips .chip{font-size:.65rem;min-height:24px}.toolCard span{display:none}#mangaSetup .field strong{display:none}.appHeader .eyebrow{display:none}}
.choiceLaunch strong{display:block;font-size:.98rem}.choiceLaunch small{display:block;font-size:.7rem;font-weight:400;color:var(--muted);margin-top:7px}
#mangaSetup .profileGrid .field{margin:0} .mangaPreview{min-height:80px;padding:8px;gap:4px}

.characterFilters{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:9px 0}.characterFilters[hidden]{display:none}.characterFilters label{display:block;min-width:0;font-size:.76rem;color:var(--muted)}.characterFilters select{width:100%;min-width:0;margin-top:4px;font-size:.82rem;padding:8px 5px;min-height:41px}#characterMatchCount{margin-top:6px}

.personChoiceFilters{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:9px 0}.personChoiceFilters[hidden]{display:none}.personChoiceFilters label{display:block;min-width:0;font-size:.76rem;color:var(--muted)}.personChoiceFilters select{width:100%;min-width:0;margin-top:4px;font-size:.82rem;padding:8px 5px;min-height:41px}#personChoiceCount{margin-top:6px}

.headerActions{display:flex;align-items:center;gap:3px;flex:none}.headerActions button{white-space:nowrap;padding-inline:8px}.layoutOrderRow{display:flex;align-items:center;gap:5px;margin:5px 0;padding:7px 8px;border:1px solid var(--border);border-radius:11px;background:var(--surface)}.layoutOrderRow .rank{font-size:.7rem;color:var(--muted);width:20px}.layoutOrderRow .title{flex:1;min-width:0;font-size:.85rem}.layoutVisibility{display:flex;align-items:center;gap:3px;white-space:nowrap;font-size:.7rem}.layoutVisibility input{margin:0;min-width:16px;min-height:16px}.layoutOrderRow button{min-width:35px;min-height:35px;padding:5px 6px;font-size:.75rem}#selectionOrderList{max-height:56dvh;overflow:auto;overscroll-behavior:contain;margin:10px 0}#resetSelectionOrder{width:100%}@media(max-width:360px){.headerActions button{font-size:.69rem;padding-inline:5px}}

.hairTendencyFilter{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:.75rem;color:var(--muted)}.hairTendencyFilter[hidden]{display:none}.hairTendencyFilter select{min-height:36px;max-width:130px;padding:5px}.hairTendencyFilter span{font-size:.7rem}
.modelControls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:10px 0}.modelControls label{min-width:0;font-size:.8rem}.modelControls select{display:block;width:100%;min-width:0;margin-top:5px}@media(max-width:340px){.modelControls{grid-template-columns:1fr}}
#pickers .picker>.chips{display:none}#choiceDialogChoices .pickedHeading{font-size:.78rem;color:var(--muted);padding:9px 3px 5px;font-weight:700;position:sticky;top:0;background:var(--bg);z-index:1}#choiceDialogChoices .pickedRow{display:flex;align-items:center;gap:6px;padding:7px 3px;border-bottom:1px solid var(--border);min-height:50px}#choiceDialogChoices .pickedName{flex:1;min-width:0;overflow-wrap:anywhere;font-size:.84rem}#choiceDialogChoices .pickedWeight,#choiceDialogChoices .pickedRemove{flex:none;min-height:36px;padding:5px 8px;font-size:.73rem}#choiceDialogChoices .pickedRemove{min-width:36px}#choiceDialogChoices .candidateHeading{font-size:.78rem;color:var(--muted);padding:10px 3px 4px;font-weight:700}#reviewDialog{max-height:92dvh;display:none;flex-direction:column;overflow:hidden}#reviewDialog[open]{display:flex}.reviewBody{overflow:auto;overscroll-behavior:contain;min-height:0;flex:1;padding:2px 1px 12px}.reviewSection{margin:0 0 13px;padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.reviewSection h3{font-size:.93rem;margin:0 0 8px}.reviewSection p{font-size:.8rem;line-height:1.55;margin:5px 0}.reviewSection .reviewKey{font-weight:700;color:var(--muted)}.reviewSection .reviewEmpty{color:var(--muted)}.reviewPerson{border-top:1px solid var(--border);padding:9px 0}.reviewPerson:first-of-type{border-top:0}.reviewPerson strong{display:block;margin-bottom:5px}.reviewActions{display:grid;grid-template-columns:1fr 1fr;gap:7px;flex:none;padding-top:10px;border-top:1px solid var(--border)}.reviewActions button{min-height:42px;font-size:.79rem;padding:7px}.reviewActions #reviewGenerate{grid-column:1/-1}#choiceFoot [data-review]{font-size:.75rem;padding:7px 9px}.toolGrid [data-review]{border-color:#68857f}#downloadMangaFrame{width:100%;min-height:42px;margin-top:9px;font-size:.82rem}.mangaFrameHint{margin:5px 0 0;font-size:.72rem;color:var(--muted)}#mangaCompose{overflow:auto;min-height:0;gap:8px}#composeSlots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.composeSlot{display:grid;gap:5px;padding:9px;background:var(--surface);border:1px solid var(--border);border-radius:11px;min-width:0}.composeSlot label{font-size:.78rem;font-weight:700}.composeSlot input{font-size:.7rem;max-width:100%;min-width:0}.composeSlot select{font-size:.72rem;min-width:0}.composeSlot button{min-height:30px;padding:4px;font-size:.7rem}.composeFileName{font-size:.68rem;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#composeCanvas{display:block;max-width:100%;height:auto;max-height:47dvh;object-fit:contain;background:#fff;margin:4px auto;border:1px solid var(--border)}#saveComposedPage{width:100%;min-height:43px}#mangaPanel>.segments button{font-size:.74rem;padding:8px 2px}.reviewConflicts{border-color:#b59a63}.reviewConflict{padding:10px 0;border-top:1px solid var(--border)}.reviewConflict strong{font-size:.83rem}.reviewConflictActions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px}.reviewConflictActions button{min-height:38px;font-size:.71rem;padding:5px;line-height:1.35}.picker .choiceLaunch{display:flex;flex-direction:column;justify-content:center;min-height:0;overflow:hidden}.picker .choiceLaunch strong,.picker .choiceLaunch small{flex:none}.cardSelections{display:flex;flex-direction:column;gap:3px;min-width:0;max-width:100%;max-height:84px;overflow:hidden;margin-top:6px}.cardSelection{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border-radius:6px;padding:2px 6px;background:#284e4b;color:#dbf5ee;font-size:.68rem;line-height:1.25}.cardMore{background:transparent;color:var(--muted);padding:0 4px}@media(max-height:680px){.cardSelections{max-height:48px}.cardSelection:nth-child(n+3){display:none}.cardSelection{font-size:.64rem;padding:1px 5px}}.cardSelection:not(.cardMore){display:flex;align-items:center;min-height:23px;padding:0 2px 0 6px;overflow:visible}.cardSelectionName{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cardSelectionRemove{display:grid;place-items:center;flex:none;width:27px;height:27px;cursor:pointer;font-size:1rem;font-weight:700;line-height:1;border-radius:6px;touch-action:manipulation}.cardSelectionRemove:focus-visible{outline:2px solid #a6f4df;outline-offset:-2px}.cardSelectionRemove:active{background:#58736b}@media(max-height:680px){.cardSelectionRemove{width:23px;height:23px}}.weightedChip{display:inline-flex;align-items:center;max-width:100%;gap:2px;border-radius:11px;background:var(--accent,#4f46e5);padding:2px}.weightedChip .chipName{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:5px 4px;font-size:.8rem}.weightedChip button{min-height:32px;padding:3px 7px;font-size:.75rem}.weightedChip .chipRemove{min-width:32px}#chips-character .weightedChip{background:var(--surface,#252b3b)}
